<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Microsoft.Maui.Resizetizer</RootNamespace>
    <AssemblyName>Microsoft.Maui.Resizetizer</AssemblyName>
    <!--<Nullable>enable</Nullable>-->
    <!-- Suppresses the warnings about the package not having assemblies in lib/*/.dll.-->
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- Do not include any assemblies from this project as we will do it manually -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- ILRepack this assembly and add a strong name and version -->
    <ILRepackBeforePack>true</ILRepackBeforePack>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet package information -->
    <IsPackable>true</IsPackable>
    <PackageId>Microsoft.Maui.Resizetizer</PackageId>
    <Description>.NET Multi-platform App UI (.NET MAUI) is a cross-platform framework for creating native mobile and desktop apps with C# and XAML. This package contains image, font and raw asset processing tools.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**"
                      Exclude="Resources\ErrorMessages.resx"
                      LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="ResizetizerPackages.projitems" />

  <!-- A small task to make sure everything depends on the same version of SkiaSharp -->
  <ItemGroup>
    <PackageReference Include="Mono.ApiTools.MSBuildTasks" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <_AdjustmentsAssembly>$(PkgSvg_Skia)\lib\netstandard2.0\Svg.Skia.dll</_AdjustmentsAssembly>
    <_AdjustmentsReferencedAssembly>$(PkgSkiaSharp)\lib\net462\SkiaSharp.dll</_AdjustmentsReferencedAssembly>
  </PropertyGroup>
  <Target Name="_AdjustSkiaSharpVersion" BeforeTargets="Build;AssignTargetPaths" Inputs="$(MSBuildProjectFile);$(_AdjustmentsAssembly);$(_AdjustmentsReferencedAssembly)" Outputs="$(IntermediateOutputPath)adjustments\Svg.Skia.dll">
    <MakeDir Directories="$(IntermediateOutputPath)adjustments" />
    <AdjustReferencedAssemblyVersion Assembly="$(_AdjustmentsAssembly)" ReferencedAssembly="$(_AdjustmentsReferencedAssembly)" OutputAssembly="$(IntermediateOutputPath)adjustments\Svg.Skia.dll" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)adjustments\Svg.Skia.dll" Visible="false" Pack="true" PackagePath="buildTransitive" />
      <FileWrites Include="$(IntermediateOutputPath)adjustments\Svg.Skia.dll" />
    </ItemGroup>
  </Target>

  <!--
    Keep the net462 native loaders, but bind span APIs to the same System.Memory as Svg.Skia
    to prevent the SVG filter/text MissingMethodException (dotnet/maui#38319, #39165).
    Remove this adjustment only when the unmodified rendering assemblies have compatible
    System.Memory references and PackagedResizetizerRendersSvgFiltersAndText passes without
    it in both dotnet MSBuild and Windows full-framework MSBuild. An upgrade alone is not proof.
    Restore the original package DLL paths in ResizetizerPackages.projitems at the same time;
    keep the regression test.
  -->
  <ItemGroup>
    <_MemoryAdjustments Include="$(PkgSkiaSharp)\lib\net462\SkiaSharp.dll" />
    <_MemoryAdjustments Include="$(PkgSkiaSharp_HarfBuzz)\lib\net462\SkiaSharp.HarfBuzz.dll" />
    <_MemoryAdjustments Include="$(PkgHarfBuzzSharp)\lib\net462\HarfBuzzSharp.dll" />
  </ItemGroup>
  <PropertyGroup>
    <_MemoryAdjustmentsReferencedAssembly>$(PkgSystem_Memory)\lib\netstandard2.0\System.Memory.dll</_MemoryAdjustmentsReferencedAssembly>
  </PropertyGroup>
  <Target Name="_AdjustSystemMemoryVersion" BeforeTargets="Build;AssignTargetPaths"
          Inputs="$(MSBuildAllProjects);$(_MemoryAdjustmentsReferencedAssembly);@(_MemoryAdjustments)"
          Outputs="@(_MemoryAdjustments->'$(IntermediateOutputPath)adjustments\%(Filename)%(Extension)')">
    <MakeDir Directories="$(IntermediateOutputPath)adjustments" />
    <!-- The adjustment task does not write an output when no reference change is needed. -->
    <Copy SourceFiles="@(_MemoryAdjustments)"
          DestinationFiles="@(_MemoryAdjustments->'$(IntermediateOutputPath)adjustments\%(Filename)%(Extension)')" />
    <AdjustReferencedAssemblyVersion
      Assembly="$(IntermediateOutputPath)adjustments\%(_MemoryAdjustments.Filename)%(_MemoryAdjustments.Extension)"
      ReferencedAssembly="$(_MemoryAdjustmentsReferencedAssembly)" />
    <ItemGroup>
      <FileWrites Include="@(_MemoryAdjustments->'$(IntermediateOutputPath)adjustments\%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <Import Project="$(MauiRootDirectory)eng\ILRepack.targets" />
  <Target Name="AfterILRepack">
    <ItemGroup>
      <None Include="@(ILRepackOutput)" Visible="false" Pack="true" PackagePath="buildTransitive\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="@(_ResizetizerFiles)" Visible="false" Pack="true" PackagePath="buildTransitive/%(Arch)" />
    <None Include="nuget\**" Pack="true" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ErrorMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ErrorMessages.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="ErrorMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ErrorMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
 
  <Target Name="_CopyToBuildTasksDir" AfterTargets="Build">
    <ItemGroup>
      <_CopyItems Include="$(TargetDir)$(AssemblyName).dll" />
      <_CopyItems Include="$(TargetDir)$(AssemblyName).pdb" />
      <_CopyItems Include="nuget\buildTransitive\**" />
      <_CopyItems Include="@(_ResizetizerFiles)" />
    </ItemGroup>
    <Copy SourceFiles="@(_CopyItems)" DestinationFolder="$(_MauiBuildTasksLocation)%(RecursiveDir)%(_CopyItems.Arch)" ContinueOnError="true" Retries="3" RetryDelayMilliseconds="1000" />
    <MakeDir Directories="$(IntermediateOutputPath)adjustments" />
    <AdjustReferencedAssemblyVersion
      Assembly="$(_AdjustmentsAssembly)"
      ReferencedAssembly="$(_AdjustmentsReferencedAssembly)"
      OutputAssembly="$(IntermediateOutputPath)adjustments\Svg.Skia.dll" />
    <Copy SourceFiles="$(IntermediateOutputPath)adjustments\Svg.Skia.dll" DestinationFiles="$(_MauiBuildTasksLocation)Svg.Skia.dll" ContinueOnError="true" Retries="3" RetryDelayMilliseconds="1000" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)adjustments\Svg.Skia.dll" />
    </ItemGroup>
  </Target>

  <Import Project="$(MauiSrcDirectory)Workload\Shared\LibraryPacks.targets" />

</Project>
