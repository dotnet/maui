<?xml version="1.0" encoding="UTF-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <DisableArcadeTestFramework>true</DisableArcadeTestFramework>
  </PropertyGroup>

  <Target Name="_ValidateAndroidDeviceTestRuntime" BeforeTargets="PrepareForBuild"
      Condition="$(TargetFramework.StartsWith('net12.0-android')) and '$(UseMonoRuntime)' == 'true'">
    <Error Text="The pinned .NET 12 Android SDK supports CoreCLR or NativeAOT, not MonoVM. Use UseMonoRuntime=false for current Android device tests; retained .NET 11 Mono coverage is unchanged." />
  </Target>

  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ApplicationId" />
    <CompilerVisibleProperty Include="ApplicationTitle" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="IsMauiSplashScreen" />
    <AdditionalFiles Include="@(MauiSplashScreen)" IsMauiSplashScreen="True" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioPackageVersion)" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="@(ProjectReference->WithMetadataValue('Filename', 'TestUtils.DeviceTests.Runners')->Count()) &gt; 0 and ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst')">
    <PartialAppManifest Include="$(MSBuildThisFileDirectory)TestUtils/src/DeviceTests.Runners/TestRunnerInfo.plist" Overwrite="false" />
  </ItemGroup>

</Project>