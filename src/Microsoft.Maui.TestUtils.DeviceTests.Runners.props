<?xml version="1.0" encoding="UTF-8"?>
<Project>
  <PropertyGroup>
    <MauiTestProject>true</MauiTestProject>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <RunWorkingDirectory Condition="'$(RunWorkingDirectory)' == ''">$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <RunWithOpen Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">false</RunWithOpen>
    <MtouchInterpreter Condition="'$(MtouchInterpreter)' == '' and '$(UseMonoRuntime)' == 'true' and ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst')">all</MtouchInterpreter>
    <AndroidUseInstrumentation Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</AndroidUseInstrumentation>
    <!-- Bundle Windows App SDK alongside the unpackaged executable.
         Only applies to unpackaged builds (signaled by _MauiDeviceTestUnpackaged=true from Cake script).
         Packaged (MSIX) builds must NOT set this, as it prevents MSIX generation.
         NOTE: This file is imported directly from each device test csproj, NOT via Directory.Build.props,
         because adding Directory.Build.props to these folders breaks AppxPackageDir via Arcade SDK. -->
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(_MauiDeviceTestUnpackaged)' == 'true'">true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
