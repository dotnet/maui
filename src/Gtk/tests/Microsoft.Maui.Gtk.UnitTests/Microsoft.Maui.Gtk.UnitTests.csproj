<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>$(MauiGtkTargetFramework)</TargetFramework>
    <AssemblyName>Microsoft.Maui.Gtk.UnitTests</AssemblyName>
    <RootNamespace>Microsoft.Maui.Gtk.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <MauiTestProject>true</MauiTestProject>
    <!-- Real GTK widgets are exercised on one dedicated thread (see GtkTestHost); no parallelism. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1307;CA1309;CA1310;CA1861;xUnit1013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="coverlet.collector" Version="$(CoverletCollectorPackageVersion)" />
    <PackageReference Include="xunit" Version="$(XunitPackageVersion)" />
    <PackageReference Include="GtkSharp4" />
    <PackageReference Include="GdkSharp4" />
    <PackageReference Include="GskSharp4" />
    <PackageReference Include="PangoSharp4" />
    <PackageReference Include="GrapheneSharp4" />
    <PackageReference Include="CairoSharp4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Microsoft.Maui.Gtk.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Core\Controls.Core.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Xaml\Controls.Xaml.csproj" />
    <ProjectReference Include="..\..\src\Essentials\Microsoft.Maui.Essentials.Gtk.csproj" />
    <ProjectReference Include="..\..\src\Controls\Microsoft.Maui.Controls.Gtk.csproj" />
    <ProjectReference Include="..\..\src\BlazorWebView\Microsoft.AspNetCore.Components.WebView.Maui.Gtk.csproj" />
    <ProjectReference Include="..\..\src\Maps\Microsoft.Maui.Controls.Maps.Gtk.csproj" />
  </ItemGroup>

  <!-- Project references do not import package build assets: copy the Blazor static web assets (blazor.webview.js) next to the tests. -->
  <Import Project="..\..\src\BlazorWebView\build\Microsoft.AspNetCore.Components.WebView.Maui.Gtk.targets" />

</Project>
