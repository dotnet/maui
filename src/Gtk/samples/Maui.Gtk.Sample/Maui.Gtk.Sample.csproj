<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The GtkSharp 'gtk' workload target framework (see src/Gtk/README.md, "Creating an app"). -->
    <TargetFramework>net10.0-gtk4.22</TargetFramework>
    <SingleProject>true</SingleProject>
    <RootNamespace>Maui.Gtk.Sample</RootNamespace>
    <AssemblyName>Maui.Gtk.Sample</AssemblyName>
    <IsPackable>false</IsPackable>
    <SampleProject>true</SampleProject>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <ApplicationTitle>MAUI on GTK 4</ApplicationTitle>
    <ApplicationId>com.microsoft.maui.gtk.sample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon: Resources/Icons/hicolor/*/apps/appicon.png and the com.microsoft.maui.gtk.sample.desktop entry. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <!-- Images: Resources/Images/*.png next to the app. -->
    <MauiImage Include="Resources\Images\*" BaseSize="168,208" />
    <!-- Fonts: Resources/Fonts, registered with ConfigureFonts(f => f.AddFont("OpenSans-Regular.ttf", ...)). -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw assets: next to the app, at their logical name. -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GtkSharp4" />
    <PackageReference Include="GdkSharp4" />
    <PackageReference Include="GskSharp4" />
    <PackageReference Include="PangoSharp4" />
    <PackageReference Include="GrapheneSharp4" />
    <PackageReference Include="CairoSharp4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Microsoft.Maui.Gtk.csproj" />
    <ProjectReference Include="..\..\src\Controls\Microsoft.Maui.Controls.Gtk.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Core\Controls.Core.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Xaml\Controls.Xaml.csproj" />
  </ItemGroup>

</Project>
