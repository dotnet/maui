<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(_MauiDotNetTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/UITest.Appium/UITest.Appium.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="$(XunitPackageVersion)" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="$(MicrosoftTestingPlatformVersion)" />
    <Compile Include="../../src/DeviceTests/xUnitCustomizations.cs" Link="xUnitCustomizations.cs" />
    <Compile Include="../../src/DeviceTests/RepeatAttribute.cs" Link="RepeatAttribute.cs" />
    <Compile Include="../../src/DeviceTests.Runners/NativeTestArguments.cs" Link="NativeTestArguments.cs" />
    <Compile Include="../../src/DeviceTests.Runners/HeadlessRunner/HeadlessTestRunner.cs" Link="HeadlessTestRunner.cs" />
    <Compile Include="../../src/DeviceTests.Runners/HeadlessRunnerOptions.cs" Link="HeadlessRunnerOptions.cs" />
    <Compile Include="../../src/DeviceTests.Runners/TestOptions.cs" Link="TestOptions.cs" />
    <Compile Include="../../src/DeviceTests.Runners/WindowsUiTestFramework.Windows.cs" Link="WindowsUiTestFramework.cs" />
    <Compile Include="../../../../.github/skills/run-device-tests/scripts/windows-launcher/WindowsTestCommandLine.cs" Link="WindowsTestCommandLine.cs" />
    <Compile Include="../../../../.github/skills/run-device-tests/scripts/windows-launcher/PackagedTestSession.cs" Link="PackagedTestSession.cs" />
  </ItemGroup>
</Project>
