<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			xmlns:maui="http://schemas.microsoft.com/dotnet/2021/maui"
			xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			xmlns:scoped="clr-namespace:Microsoft.Maui.Controls.Xaml.UnitTests.ScopedExtensions"
			x:Class="Microsoft.Maui.Controls.Xaml.UnitTests.ScopedExtensionProperties">
	<!-- an ordinary qualified property element whose owner is unrelated to the target: the qualifier is
	     ignored and Resources resolves on the page. This is the shape ShadowBenchmark.xaml uses -->
	<ContentView.Resources>
		<ResourceDictionary>
			<x:String x:Key="legacyKey">legacy value</x:String>
		</ResourceDictionary>
	</ContentView.Resources>
	<StackLayout>
		<StackLayout.Resources>
			<x:String x:Key="tagResource">from a resource</x:String>
			<x:String x:Key="numberResource">42</x:String>
		</StackLayout.Resources>
		<!-- the container is brought in scope by the element's default xmlns -->
		<Label x:Name="label0" ScopedTag="from the default xmlns" />

		<!-- the container is in another assembly, mapped by the same xmlns -->
		<Label x:Name="label1" ExternalScopedTag="from another assembly" />

		<!-- Label.Text is an instance property and wins over the extension property of the same name -->
		<Label x:Name="label2" Text="ordinary property wins" />

		<!-- two containers in scope declare MostSpecific, for View and for Label: Label wins -->
		<Label x:Name="label3" MostSpecific="from xaml" />

		<!-- three containers in scope, two of them with incomparable receivers: the Label one wins whatever
		     the enumeration order is. The Label candidate is on the last container here... -->
		<Label x:Name="label5" ThreeWayLast="from xaml" />

		<!-- ...and on the first one here -->
		<Label x:Name="label6" ThreeWayFirst="from xaml" />

		<!-- naming the container explicitly disambiguates what is otherwise ambiguous -->
		<Label x:Name="label4" scoped:ScopedAmbiguousAExtensions.ScopedAmbiguous="explicit wins" />

		<!-- a string resource is converted to the extension property type, scoped or qualified -->
		<Label x:Name="label7" ScopedTag="{StaticResource tagResource}" />
		<Label x:Name="label8" scoped:LabelScopedExtensions.ScopedTag="{StaticResource tagResource}" />
		<Label x:Name="objectValue" ScopedTag="{scoped:ExtensionObjectValue}" />

		<!-- the extension accessor is called, not a hand-written set_Impostor(Label, string) -->
		<Label x:Name="label9" Impostor="from xaml" />

		<!-- a plain CLR property wins over the extension property of the same name -->
		<ScopedPrecedenceView x:Name="precedence" PlainClr="instance wins" />

		<!-- an explicitly implemented interface property does not hide the extension property -->
		<ScopedPrecedenceView x:Name="explicitInterface" ExplicitTag="from xaml" />
		<ScopedPrecedenceView x:Name="writableExplicitInterface" WritableExplicitTag="from xaml" />
		<ScopedPrecedenceView x:Name="qualifiedCollision" scoped:ScopedPrecedenceExtensions.Collision="{StaticResource numberResource}" />
		<VariantExtensionView x:Name="variant" VariantTag="from xaml" />
		<Label x:Name="objectLiteral" ObjectImpostor="literal" />
		<Label x:Name="objectMarkup" ObjectImpostor="{scoped:ExtensionStringValue markup}" />
		<Label x:Name="objectTarget" ObjectImpostor="{scoped:ExtensionTargetProperty}" />
		<Label x:Name="dynamicLiteral" DynamicImpostor="literal" />
		<Label x:Name="dynamicMarkup" DynamicImpostor="{scoped:ExtensionStringValue markup}" />
		<Label x:Name="convertedLiteral" ConvertedTag="literal" />
		<Label x:Name="convertedEscaped" ConvertedTag="quoted &quot;value&quot; \path" />
		<Label x:Name="convertedLocal" ConvertedTag="{StaticResource tagResource}" />
		<Label x:Name="convertedApplication" ConvertedTag="{StaticResource applicationTag}" />
		<Label x:Name="convertedIdiom" ConvertedTag="{OnIdiom Default=idiom}" />
		<Label x:Name="imageApplication" ResourceImage="{StaticResource applicationImage}" />
		<Label x:Name="idiom" ScopedTag="{OnIdiom Default=idiom}" />
		<maui:Label xmlns="using:Controls.Xaml.UnitTests.ExternalAssembly.UsingOnlyExtensions" x:Name="usingNamespace" UsingOnlyTag="from using" />
		<maui:Label xmlns="clr-namespace:httpExtensions;assembly=Microsoft.Maui.Controls.Xaml.UnitTests" x:Name="httpClrNamespace" HttpTag="from clr namespace" />
	</StackLayout>
</ContentPage>
