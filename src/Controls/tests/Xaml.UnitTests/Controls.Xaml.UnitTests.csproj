<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(_MauiDotNetTfm)</TargetFramework>
    <RootNamespace>Microsoft.Maui.Controls.Xaml.UnitTests</RootNamespace>
    <AssemblyName>Microsoft.Maui.Controls.Xaml.UnitTests</AssemblyName>
    <WarningLevel>4</WarningLevel>
    <NoWarn>$(NoWarn);0672;0219;0414;CS0436;CS0618;CA2252</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);XC0618;XC0022;XC0023;XC0025;XC0045;MAUIG2045;MAUID1000;MAUIX2005</WarningsNotAsErrors>
    <IsPackable>false</IsPackable>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <DefineConstants>$(DefineConstants);MauiAllowImplicitXmlnsDeclaration</DefineConstants>
    <ReportAnalyzer>true</ReportAnalyzer>
    <!-- We can't yet disable the namescope generation, ConstraintTypeConverter and ReferenceTypeConverter need to be ported to sourcegen
    <DefineConstants>$(DefineConstants);_MAUIXAML_SG_NAMESCOPE_DISABLE</DefineConstants>
    -->
    
    <EmitCompilerGeneratedFiles Condition="'$(Configuration)' == 'Debug'">true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <EnablePreviewFeatures>True</EnablePreviewFeatures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" Version="$(NSubstitutePackageVersion)" />
    <PackageReference Include="xunit" Version="$(XunitPackageVersion)" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="System.CodeDom" Version="7.0.0" />
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" Publish="true" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" Publish="true" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" Publish="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" Publish="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Controls\Maps\src\Controls.Maps.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Build.Tasks\Controls.Build.Tasks.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Core\Controls.Core.csproj" />
    <ProjectReference Include="..\..\..\Controls\src\Xaml\Controls.Xaml.csproj" />
    <ProjectReference Include="..\..\..\Core\src\Core.csproj" />
    <ProjectReference Include="..\..\..\Essentials\src\Essentials.csproj" />
    <ProjectReference Include="..\Xaml.UnitTests.ExternalAssembly\Controls.Xaml.UnitTests.ExternalAssembly.csproj" />
    <ProjectReference Include="..\Xaml.UnitTests.InternalsHiddenAssembly\Controls.Xaml.UnitTests.InternalsHiddenAssembly.csproj" />
    <ProjectReference Include="..\Xaml.UnitTests.InternalsVisibleAssembly\Controls.Xaml.UnitTests.InternalsVisibleAssembly.csproj" />
    <ProjectReference Include="..\Maui25871Library\Maui25871Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source-linked gallery files rely on these global imports in HostApp. -->
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Dispatching" />
    <Using Include="Microsoft.Maui.Graphics" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Core\tests\UnitTests\TestClasses\DispatcherStub.cs" Link="DispatcherStub.cs" />
    <Compile Include="..\Core.UnitTests\Log.cs" Link="Log.cs" />
    <Compile Include="..\Core.UnitTests\MockPlatformServices.cs" />
    <Compile Include="..\Core.UnitTests\MockMauiContext.cs" />
    <Compile Include="..\Core.UnitTests\MockServiceProvider.cs" />
    <Compile Include="..\Core.UnitTests\MockFontManager.cs" />
    <Compile Include="..\Core.UnitTests\MockDeviceDisplay.cs" />
    <Compile Include="..\TestCases.HostApp\FeatureMatrix\Triggers\TriggersViewModel.cs" Link="TestCases\TriggersViewModel.cs" />
    <Compile Include="..\TestCases.HostApp\Controls\UITestEntry.cs" Link="TestCases\UITestEntry.cs" />
    <Compile Include="..\TestCases.HostApp\FeatureMatrix\BindableLayout\BindableLayoutViewModel.cs" Link="TestCases\BindableLayoutViewModel.cs" />
    <Compile Include="..\TestCases.HostApp\FeatureMatrix\AbsoluteLayout\AbsoluteLayoutViewModel.cs" Link="TestCases\AbsoluteLayoutViewModel.cs" />
    <Compile Include="..\TestCases.HostApp\FeatureMatrix\Button\ButtonViewModel.cs" Link="TestCases\ButtonViewModel.cs" />
    <Compile Include="..\TestCases.HostApp\FeatureMatrix\MenuBarItem\MenuBarItemViewModel.cs" Link="TestCases\MenuBarItemViewModel.cs" />
    <Compile Include="..\TestCases.HostApp\FeatureMatrix\SafeArea\SafeAreaViewModel.cs" Link="TestCases\SafeAreaViewModel.cs" />
    <Compile Include="..\TestCases.HostApp\FeatureMatrix\SafeArea\SafeAreaExtensions.cs" Link="TestCases\SafeAreaExtensions.cs" />
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**\*.cs" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <Import Project="$(MauiSrcDirectory)Maui.InTree.props" Condition=" '$(UseMaui)' != 'true' " />

  <ItemGroup>
    <!-- by default, generate the code to test the 3 inflators -->
    <MauiXaml Update="**\*.xaml" Inflator="Runtime;SourceGen;XamlC" />

    <!-- unless an extension is specified -->
    <MauiXaml Update="**\*.rt.xaml" Inflator="Runtime" />
    <MauiXaml Update="**\*.sgen.xaml" Inflator="SourceGen" />
    <MauiXaml Update="**\*.xc.xaml" Inflator="XamlC" />
    <MauiXaml Update="**\*.rtsg.xaml" Inflator="Runtime;SourceGen" />
    <MauiXaml Update="**\*.rtxc.xaml" Inflator="Runtime;XamlC" />
    <MauiXaml Update="**\*.sgxc.xaml" Inflator="SourceGen;XamlC" />    

    <MauiXaml Update="FontSize.xaml" NoWarn="0612;0618" />
    <MauiXaml Update="Issues\Bz55343.xaml" NoWarn="0612" />
    <MauiXaml Update="Issues\Issue1438.xaml" NoWarn="0612" />
    <MauiXaml Update="Issues\Issue2578.xaml" NoWarn="0612" />
    <MauiXaml Update="Issues\Issue2659.xaml" NoWarn="0612" />

    <MauiXaml Update="Benchmark.xaml" TreeOrder="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exercise the gallery's actual markup and event handlers, not copies of its state machines. -->
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\VisualStateManager\VSMLabel\VisualStateManagerLabelPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\VisualStateManager\VSMButton\VisualStateManagerButtonPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\VisualStateManager\VSMCheckBox\VisualStateManagerCheckBoxPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\VisualStateManager\VSMSwitch\VisualStateManagerSwitchPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\VisualStateManager\VSMSlider\VisualStateManagerSliderPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\VisualStateManager\VSMEntry\VisualStateManagerEntryPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\BindableLayout\BindableLayoutControlPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\BindableLayout\BindableLayoutOptionsPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\AbsoluteLayout\AbsoluteLayoutControlPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\AbsoluteLayout\AbsoluteLayoutOptionsPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\Button\ButtonControlPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\Button\ButtonOptionsPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\MenuBarItem\MenuBarItemControlPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\SafeArea\SafeAreaOptionsPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\SafeArea\ContentPage\SafeAreaContentPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\SafeArea\ContentView\SafeAreaContentViewPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\SafeArea\Border\SafeAreaBorderPage.xaml" />
    <_GalleryTestPage Include="..\TestCases.HostApp\FeatureMatrix\SafeArea\Layout\Grid\SafeAreaGridPage.xaml" />
    <Compile Include="@(_GalleryTestPage->'%(Identity).cs')" Link="TestCases\%(Filename)%(Extension)" />
    <MauiXaml Include="@(_GalleryTestPage)" Link="TestCases\%(Filename)%(Extension)" Inflator="Runtime;SourceGen;XamlC" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- MSBuild test support files - copy to output for Helix -->
    <Content Include="MSBuild\_Directory.Build.props" CopyToOutputDirectory="PreserveNewest" Link="MSBuild\_Directory.Build.props" />
    <Content Include="MSBuild\_Directory.Build.targets" CopyToOutputDirectory="PreserveNewest" Link="MSBuild\_Directory.Build.targets" />
  </ItemGroup>

</Project>
