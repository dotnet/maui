<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			xmlns:local="clr-namespace:Microsoft.Maui.Controls.Xaml.UnitTests"
			x:Class="Microsoft.Maui.Controls.Xaml.UnitTests.QualifiedMemberOwner">
	<StackLayout>
		<!-- the named owner is a base class of the target, and declares the property -->
		<local:QualifiedMemberProbe x:Name="probe0" local:QualifiedMemberProbeBase.BaseOnly="from base owner" />

		<!-- the named owner is an interface the target implements, and declares the property -->
		<local:QualifiedMemberProbe x:Name="probe1" local:IQualifiedMemberProbe.InterfaceOnly="from interface owner" />

		<!-- property element syntax with a base owner -->
		<local:QualifiedMemberProbe x:Name="probe2">
			<local:QualifiedMemberProbeBase.BaseOnly>
				<x:String>from base owner property element</x:String>
			</local:QualifiedMemberProbeBase.BaseOnly>
		</local:QualifiedMemberProbe>
	</StackLayout>
</ContentPage>
