<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Microsoft.Maui.Controls.Xaml.UnitTests.Maui40201">
    <ContentPage.Resources>
        <Style TargetType="Border">
            <Setter Property="Background" Value="{AppThemeBinding Light='#e9f9ff', Dark='#616161'}" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeShape" Value="{RoundRectangle CornerRadius=20}" />
        </Style>
        <Style x:Key="DefaultBackground" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <AppThemeBinding Default="#e9f9ff" Dark="#616161" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>
    <VerticalStackLayout>
        <Border x:Name="zeroStrokeBorder">
            <Label Text="Hello, World!" />
        </Border>
        <Border x:Name="positiveStrokeBorder" StrokeThickness="2">
            <Label Text="Hello, World!" />
        </Border>
        <Border x:Name="defaultBackgroundBorder" Style="{StaticResource DefaultBackground}">
            <Label Text="Default theme value" />
        </Border>
    </VerticalStackLayout>
</ContentPage>
