<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Microsoft.Maui.Controls.Xaml.UnitTests"
             x:Class="Microsoft.Maui.Controls.Xaml.UnitTests.Maui30644"
             x:DataType="local:Maui30644ViewModel">
    <StackLayout>
        <Picker x:Name="SelectedItemFirstPicker"
                SelectedItem="{Binding FirstSelectedValue}"
                ItemsSource="{Binding Values}" />
        <Picker x:Name="ItemsSourceFirstPicker"
                ItemsSource="{Binding Values}"
                SelectedItem="{Binding SecondSelectedValue}" />
    </StackLayout>
</ContentPage>
