<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:anim="http://schemas.microsoft.com/dotnet/2021/maui/animations"
			 x:Class="Microsoft.Maui.Controls.Xaml.UnitTests.PageTransitionsXaml"
			 anim:PageTransitions.Transition="SlideFromBottom"
			 anim:PageTransitions.ModalTransition="Fade"
			 anim:SharedTransition.Group="42">
	<anim:PageTransitions.TabTransition>
		<anim:ScaleTransition FromScale="0.5" Duration="0:0:0.25" Easing="CubicOut" />
	</anim:PageTransitions.TabTransition>
	<VerticalStackLayout>
		<BoxView x:Name="photo" anim:SharedTransition.Name="photo" anim:SharedTransition.Group="42" />
		<ContentView x:Name="none" anim:PageTransitions.Transition="None" />
		<ContentView x:Name="platform" anim:PageTransitions.Transition="Platform" />
		<ContentView x:Name="explicitSlide">
			<anim:PageTransitions.Transition>
				<anim:SlideTransition From="Start" Duration="0:0:0.45" Easing="SinInOut" Background="Red" />
			</anim:PageTransitions.Transition>
		</ContentView>
		<ContentView x:Name="fade">
			<anim:PageTransitions.Transition>
				<anim:FadeTransition Duration="0:0:1" />
			</anim:PageTransitions.Transition>
		</ContentView>
	</VerticalStackLayout>
</ContentPage>
