<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:local="clr-namespace:Microsoft.Maui.Controls.Xaml.UnitTests"
             x:Class="Microsoft.Maui.Controls.Xaml.UnitTests.ContentButtonPage"
             x:DataType="local:ContentButtonViewModel">
    <ContentPage.Resources>
        <Color x:Key="ButtonBorder">Red</Color>
        <Style TargetType="ContentButton">
            <Setter Property="Padding" Value="1,2,3,4" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderColor" Value="{DynamicResource ButtonBorder}" />
            <Setter Property="android:ContentButton.RippleColor" Value="#40808080" />
        </Style>
    </ContentPage.Resources>
    <ContentButton x:Name="button"
                   SemanticProperties.Description="{Binding Caption}"
                   Command="{Binding Action}"
                   CommandParameter="{Binding Parameter}">
        <Label x:Name="caption" Text="{Binding Caption}" />
    </ContentButton>
</ContentPage>
