<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Microsoft.Maui.Controls.Xaml.UnitTests.BottomSheetProperties"
             BottomSheet.IsEnabled="True"
             BottomSheet.Detents="30%, Medium, Large"
             BottomSheet.SelectedDetent="{Binding Selected}"
             BottomSheet.HasDragHandle="False"
             BottomSheet.IsDismissible="False"
             BottomSheet.CornerRadius="24">
    <ContentView x:Name="fitPage"
                 BottomSheet.Detents="250, FitContent"
                 BottomSheet.SelectedDetent="FitContent" />
</ContentPage>
