<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample"
             x:Class="Maui.Controls.Sample.ProgressBarControlPage"
             x:DataType="local:ProgressBarViewModel"
             Title="ProgressBarFeature">
       <ContentPage.Resources>
              <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
              <local:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
       </ContentPage.Resources>

       <Grid ColumnDefinitions="0.5*, 0.5*"
             RowDefinitions="*, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
             RowSpacing="10"
             ColumnSpacing="15"
             Padding="20">
              <Grid Grid.ColumnSpan="2">
                     <ProgressBar x:Name="progressBarControl"
                                  AutomationId="ProgressBarControl"
                                  BackgroundColor="{Binding BackgroundColor}"
                                  FlowDirection="{Binding FlowDirection}"
                                  IsEnabled="{Binding IsEnabled}"
                                  IsVisible="{Binding IsVisible}"
                                  Progress="{Binding Progress}"
                                  ProgressColor="{Binding ProgressColor}"
                                  SemanticProperties.Description="Download progress"
                                  Shadow="{Binding Shadow}"/>
              </Grid>

              <!-- Progress -->
              <Label Grid.Row="1"
                     Grid.Column="0"
                     Text="{Binding Progress, StringFormat='Progress: {0:F2}'}"
                     HorizontalOptions="Start"
                     VerticalOptions="Center"/>
              <local:UITestEntry Grid.Row="1"
                                 Grid.Column="1"
                                 AutomationId="ProgressEntry"
                                 IsCursorVisible="False"
                                 Text="{Binding ProgressText}"
                                 Keyboard="Numeric"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Center"
                                 WidthRequest="100"/>

              <!-- BackgroundColor -->
              <Label Grid.Row="2"
                     Grid.Column="0"
                     Text="Background Color:"
                     VerticalOptions="Center"/>
              <StackLayout Grid.Row="2"
                           Grid.Column="1"
                           Orientation="Horizontal"
                           Spacing="5"
                           VerticalOptions="Center">
                     <Button Text="Orange"
                             BackgroundColor="Orange"
                             TextColor="White"
                             Command="{Binding BackgroundColorCommand}"
                             CommandParameter="{x:Static Colors.Orange}"
                             AutomationId="BackgroundColorOrangeButton"/>
                     <Button Text="Light Blue"
                             BackgroundColor="LightBlue"
                             TextColor="Black"
                             Command="{Binding BackgroundColorCommand}"
                             CommandParameter="{x:Static Colors.LightBlue}"
                             AutomationId="BackgroundColorLightBlueButton"/>
              </StackLayout>

              <!-- IsVisible -->
              <Label Grid.Row="3"
                     Grid.Column="0"
                     Text="Is Visible:"
                     VerticalOptions="Center"/>
              <StackLayout Grid.Row="3"
                           Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalOptions="Center">
                     <RadioButton AutomationId="IsVisibleTrueRadio"
                                  GroupName="IsVisible"
                                  Content="True"
                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"/>
                     <RadioButton AutomationId="IsVisibleFalseRadio"
                                  GroupName="IsVisible"
                                  Content="False"
                                  IsChecked="{Binding IsVisible, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}"/>
              </StackLayout>

              <!-- Flow Direction -->
              <Label Grid.Row="4"
                     Grid.Column="0"
                     Text="Flow Direction:"
                     FontSize="15"
                     VerticalOptions="Center"/>
              <StackLayout Grid.Row="4"
                           Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalOptions="Center">
                     <RadioButton AutomationId="FlowDirectionLTR"
                                  GroupName="FlowDirection"
                                  Content="LTR"
                                  IsChecked="{Binding FlowDirection, Mode=TwoWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static FlowDirection.LeftToRight}}"/>
                     <RadioButton AutomationId="FlowDirectionRTL"
                                  GroupName="FlowDirection"
                                  Content="RTL"
                                  IsChecked="{Binding FlowDirection, Mode=TwoWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static FlowDirection.RightToLeft}}"/>
              </StackLayout>

              <!-- Progress Color -->
              <Label Grid.Row="5"
                     Grid.Column="0"
                     Text="Progress Color:"
                     VerticalOptions="Center"/>
              <StackLayout Grid.Row="5"
                           Grid.Column="1"
                           Orientation="Horizontal"
                           Spacing="5"
                           VerticalOptions="Center">
                     <Button Text="Green"
                             BackgroundColor="Green"
                             TextColor="White"
                             Command="{Binding ProgressColorCommand}"
                             CommandParameter="{x:Static Colors.Green}"
                             AutomationId="ProgressColorGreenButton"/>
                     <Button Text="Red"
                             BackgroundColor="Red"
                             TextColor="White"
                             Command="{Binding ProgressColorCommand}"
                             CommandParameter="{x:Static Colors.Red}"
                             AutomationId="ProgressColorRedButton"/>
              </StackLayout>

              <!-- Shadow -->
              <Label Grid.Row="6"
                     Grid.Column="0"
                     Text="Shadow:"
                     VerticalOptions="Center"/>
              <StackLayout Grid.Row="6"
                           Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalOptions="Center">
                     <RadioButton AutomationId="ShadowFalseRadio"
                                  GroupName="Shadow"
                                  Content="False"
                                  IsChecked="{Binding HasShadow, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}"/>
                     <RadioButton AutomationId="ShadowTrueRadio"
                                  GroupName="Shadow"
                                  Content="True"
                                  IsChecked="{Binding HasShadow, Mode=TwoWay}"/>
              </StackLayout>

              <!-- IsEnabled -->
              <Label Grid.Row="7"
                     Grid.Column="0"
                     Text="Is Enabled:"
                     VerticalOptions="Center"/>
              <StackLayout Grid.Row="7"
                           Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalOptions="Center">
                     <RadioButton AutomationId="IsEnabledTrueRadio"
                                  GroupName="IsEnabled"
                                  Content="True"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                     <RadioButton AutomationId="IsEnabledFalseRadio"
                                  GroupName="IsEnabled"
                                  Content="False"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}"/>
              </StackLayout>

              <Label Grid.Row="8"
                     Grid.Column="0"
                     Text="Progress:"
                     FontSize="16"
                     VerticalTextAlignment="Center"/>
              <Label Grid.Row="8"
                     Grid.Column="1"
                     Text="{Binding Progress, Source={x:Reference progressBarControl}, x:DataType=ProgressBar, StringFormat='{0:F2}'}"
                     FontSize="16"
                     VerticalTextAlignment="Center"
                     AutomationId="ProgressValueLabel"/>

              <Label Grid.Row="9"
                     Grid.Column="0"
                     Text="ProgressTo"/>
              <local:UITestEntry Grid.Row="9"
                                 Grid.Column="1"
                                 AutomationId="ProgressToEntry"
                                 IsCursorVisible="False"
                                 Keyboard="Numeric"
                                 Text="{Binding ProgressToText}"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Center"
                                 WidthRequest="100"/>

              <Button Grid.Row="10"
                      Grid.Column="0"
                      Text="ProgressTo"
                      Clicked="ProgressToButton_Clicked"
                      AutomationId="ProgressToButton"/>
              <Button Grid.Row="10"
                      Grid.Column="1"
                      Text="Reset"
                      Clicked="ResetButton_Clicked"
                      AutomationId="ResetButton"/>
       </Grid>
</ContentPage>
