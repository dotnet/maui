<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample"
             x:Class="Maui.Controls.Sample.SearchBarOptionsPage"
             x:DataType="local:SearchBarViewModel"
             Title="OptionsPage">
       <ContentPage.ToolbarItems>
              <ToolbarItem Text="Apply"
                           Clicked="ApplyButton_Clicked"
                           AutomationId="Apply"/>
       </ContentPage.ToolbarItems>

       <Grid ColumnSpacing="12"
             RowSpacing="-1"
             Margin="2"
             RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
             ColumnDefinitions="0.5*,0.5*">

              <!-- Text -->
              <HorizontalStackLayout Grid.Row="0"
                                     Grid.Column="0">
                     <Label Text="Text:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <Entry AutomationId="TextEntry"
                            HeightRequest="34"
                            HorizontalOptions="Start"
                            Text="{Binding Text}"
                            VerticalOptions="Center"
                            WidthRequest="105"/>
              </HorizontalStackLayout>

              <!-- Placeholder -->
              <HorizontalStackLayout Grid.Row="0"
                                     Grid.Column="1">
                     <Label Text="Placeholder:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <Entry AutomationId="PlaceholderEntry"
                            HeightRequest="34"
                            HorizontalOptions="Start"
                            Text="{Binding Placeholder}"
                            VerticalOptions="Center"
                            WidthRequest="105"/>
              </HorizontalStackLayout>

              <!-- Text Color -->
              <HorizontalStackLayout Grid.Row="1"
                                     Grid.Column="0"         
                                     VerticalOptions="Center">
                     <Label Text="TextColor:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <Button AutomationId="TextColorRedButton"
                             BackgroundColor="Red"
                             Clicked="OnTextColorButtonClicked"
                             FontSize="13"
                             HeightRequest="34"
                             Text="Red"
                             TextColor="White"/>
                     <Button AutomationId="TextColorGreenButton"
                             BackgroundColor="Green"
                             Clicked="OnTextColorButtonClicked"
                             FontSize="13"
                             HeightRequest="34"
                             Text="Green"
                             TextColor="White"/>
              </HorizontalStackLayout>

                <!-- Selection Length -->
              <HorizontalStackLayout Grid.Row="1"
                                     Grid.Column="1">
                     <Label Text="SelectionLen:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <Entry AutomationId="SelectionLengthEntry"
                            HeightRequest="34"
                            Keyboard="Numeric"
                            HorizontalOptions="Start"
                            Text="{Binding SelectionLength}"
                            WidthRequest="55"/>
              </HorizontalStackLayout>


              <!-- Flow Direction -->
              <HorizontalStackLayout Grid.Row="2"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="34">
                     <Label Text="FlowDirection:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton x:Name="FlowDirectionLTR"
                                  AutomationId="FlowDirectionLTR"
                                  GroupName="FlowDirection"
                                  IsChecked="True"
                                  FontSize="13"
                                  Content="LTR"
                                  CheckedChanged="OnFlowDirectionRadioButtonCheckedChanged"/>
                     <RadioButton x:Name="FlowDirectionRTL"
                                  AutomationId="FlowDirectionRTL"
                                  GroupName="FlowDirection"
                                  FontSize="13"
                                  Content="RTL"
                                  CheckedChanged="OnFlowDirectionRadioButtonCheckedChanged"/>
              </HorizontalStackLayout>

              <!-- Placeholder Color -->
              <HorizontalStackLayout Grid.Row="3"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Spacing="4"
                                     VerticalOptions="Center">
                     <Label Text="PlaceholderColor:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <Button AutomationId="PlaceholderColorRedButton"
                             BackgroundColor="Red"
                             Clicked="OnPlaceholderColorButtonClicked"
                             FontSize="13"
                             HeightRequest="34"
                             Text="Red"
                             TextColor="White"/>
                     <Button AutomationId="PlaceholderColorGreenButton"
                             BackgroundColor="Green"
                             Clicked="OnPlaceholderColorButtonClicked"
                             FontSize="13"
                             HeightRequest="34"
                             Text="Green"
                             TextColor="White"/>
              </HorizontalStackLayout>

              <!-- Text Transform -->
              <HorizontalStackLayout Grid.Row="4"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="34"
                                     VerticalOptions="Center">
                     <Label Text="TextTransform:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton GroupName="TextTransform"
                                  AutomationId="TextTransformUppercaseButton"
                                  FontSize="13"
                                  CheckedChanged="OnTextTransformRadioButtonCheckedChanged"
                                  Content="Upper"/>
                     <RadioButton GroupName="TextTransform"
                                  AutomationId="TextTransformLowercaseButton"
                                  FontSize="13"
                                  CheckedChanged="OnTextTransformRadioButtonCheckedChanged"
                                  Content="Lower"/>
              </HorizontalStackLayout>

              <!-- Cancel Button Color -->
              <HorizontalStackLayout Grid.Row="5"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Spacing="4"
                                     VerticalOptions="Center">
                     <Label FontSize="12"
                            Text="CancelBtnColor:"
                            VerticalOptions="Center"/>
                     <Button AutomationId="CancelButtonOrangeColor"
                             BackgroundColor="Orange"
                             Clicked="OnCancelButtonColorClicked"
                             FontSize="13"
                             HeightRequest="34"
                             Text="Orange"
                             TextColor="Black"/>
                     <Button AutomationId="CancelButtonYellowColor"
                             BackgroundColor="Yellow"
                             Clicked="OnCancelButtonColorClicked"
                             FontSize="13"
                             HeightRequest="34"
                             Text="Yellow"
                             TextColor="Black"/>
              </HorizontalStackLayout>

              <!-- Font Attributes -->
              <HorizontalStackLayout Grid.Row="6"
                                     Grid.Column="0"
                                     HeightRequest="34"
                                     Spacing="4"
                                     VerticalOptions="Center">
                     <Label Text="FontAttrib:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton GroupName="FontAttributes"
                                  AutomationId="FontAttributesItalicButton"
                                  FontSize="13"
                                  CheckedChanged="OnFontAttributesRadioButtonCheckedChanged"
                                  Content="Italic"/>
                     <RadioButton GroupName="FontAttributes"
                                  AutomationId="FontAttributesBoldButton"
                                  FontSize="13"
                                  CheckedChanged="OnFontAttributesRadioButtonCheckedChanged"
                                  Content="Bold"/>
              </HorizontalStackLayout>

               <!-- Cursor Position -->
              <HorizontalStackLayout Grid.Row="6"
                                     Grid.Column="1">
                     <Label FontSize="12"
                            Text="CursorPosition:"
                            VerticalOptions="Center"/>
                     <Entry AutomationId="CursorPositionEntry"
                            HeightRequest="34"
                            Text="{Binding CursorPosition}"
                            Keyboard="Numeric"
                            HorizontalOptions="Start"
                            WidthRequest="55"/>
              </HorizontalStackLayout>

                <!-- Character Spacing -->
              <HorizontalStackLayout Grid.Row="7"
                                     Grid.Column="0">
                     <Label FontSize="12"
                            Text="CharSpacing:"
                            VerticalOptions="Center"/>
                     <Entry AutomationId="CharacterSpacingEntry"
                            HeightRequest="34"
                            Keyboard="Numeric"
                            HorizontalOptions="Start"
                            Text="{Binding CharacterSpacing}"
                            WidthRequest="55"/>
              </HorizontalStackLayout>

              <!-- Font Size -->
              <HorizontalStackLayout Grid.Row="7"
                                     Grid.Column="1">
                     <Label Text="FontSize:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <Entry AutomationId="FontSizeEntry"
                            HeightRequest="34"
                            Keyboard="Numeric"
                            HorizontalOptions="Start"
                            Text="{Binding FontSize}"
                            WidthRequest="55"/>
              </HorizontalStackLayout>

               <!-- MaxLength -->
              <HorizontalStackLayout Grid.Row="8"
                                     Grid.Column="0">
                     <Label Text="MaxLength:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <Entry AutomationId="MaxLengthEntry"
                            HeightRequest="34"
                            Keyboard="Numeric"
                            HorizontalOptions="Start"
                            Text="{Binding MaxLength}"
                            WidthRequest="55"/>
              </HorizontalStackLayout>

              <!-- IsTextPredictionEnabled -->
              <HorizontalStackLayout Grid.Row="8"
                                     Grid.Column="1">
                     <Label Text="TextPrediction:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton HeightRequest="34"
                                  FontSize="13"
                                  GroupName="IsTextPredictionEnabled"
                                  AutomationId="IsTextPredictionEnabledFalseButton"
                                  CheckedChanged="OnIsTextPredictionEnabledRadioButtonCheckedChanged"
                                  Content="False"/>
              </HorizontalStackLayout>

              <!-- Horizontal Text Alignment -->
              <HorizontalStackLayout Grid.Row="9"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="34"
                                     Spacing="4"
                                     VerticalOptions="Center">
                     <Label Text="HAlignment:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton GroupName="HorizontalTextAlignment"
                                  AutomationId="HorizontalTextAlignmentCenterButton"
                                  FontSize="13"
                                  CheckedChanged="OnHorizontalTextAlignmentRadioButtonCheckedChanged"
                                  Content="Center"/>
                     <RadioButton GroupName="HorizontalTextAlignment"
                                  AutomationId="HorizontalTextAlignmentEndButton"
                                  FontSize="13"
                                  CheckedChanged="OnHorizontalTextAlignmentRadioButtonCheckedChanged"
                                  Content="End"/>
              </HorizontalStackLayout>

              <!-- IsEnabled -->
              <HorizontalStackLayout Grid.Row="10"
                                     Grid.Column="0">
                     <Label Text="IsEnabled:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton HeightRequest="34"
                                  FontSize="13"
                                  GroupName="IsEnabled"
                                  AutomationId="IsEnabledFalseButton"
                                  Content="False"
                                  CheckedChanged="OnIsEnabledRadioButtonCheckedChanged"/>
              </HorizontalStackLayout>

              <!-- IsVisible -->
              <HorizontalStackLayout Grid.Row="10"
                                     Grid.Column="1">
                     <Label Text="IsVisible:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton HeightRequest="34"
                                  FontSize="13"
                                  GroupName="IsVisible"
                                  AutomationId="IsVisibleFalseButton"
                                  Content="False"
                                  CheckedChanged="OnIsVisibleRadioButtonCheckedChanged"/>
              </HorizontalStackLayout>

              <!-- Vertical Text Alignment -->
              <HorizontalStackLayout Grid.Row="11"
                                     Grid.Column="0"
                                     HeightRequest="34"
                                     VerticalOptions="Center">
                     <Label Text="VAlignment:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton GroupName="VerticalTextAlignment"
                                  AutomationId="VerticalTextAlignmentStartButton"
                                  FontSize="13"
                                  CheckedChanged="OnVerticalTextAlignmentRadioButtonCheckedChanged"
                                  Content="Start"/>
                     <RadioButton GroupName="VerticalTextAlignment"
                                  AutomationId="VerticalTextAlignmentEndButton"
                                  FontSize="13"
                                  CheckedChanged="OnVerticalTextAlignmentRadioButtonCheckedChanged"
                                  Content="End"/>
              </HorizontalStackLayout>

               <!-- Shadow -->
              <HorizontalStackLayout Grid.Row="11"
                                     Grid.Column="1">
                     <Label Text="Shadow:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton GroupName="Shadow"
                                  FontSize="13"
                                  AutomationId="ShadowTrueButton"
                                  Content="True"
                                  CheckedChanged="OnShadowRadioButtonCheckedChanged"/>
              </HorizontalStackLayout>

              <!-- Search Icon Color -->
              <HorizontalStackLayout Grid.Row="12"
                                     Grid.Column="0"
                                     Spacing="4"
                                     VerticalOptions="Center">
                     <Label Text="SearchIcon:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <Button AutomationId="SearchIconColorBlueButton"
                             BackgroundColor="Blue"
                             Clicked="OnSearchIconColorButtonClicked"
                             FontSize="13"
                             HeightRequest="34"
                             Text="Blue"
                             TextColor="White"/>
                     <Button AutomationId="SearchIconColorRedButton"
                             BackgroundColor="Red"
                             Clicked="OnSearchIconColorButtonClicked"
                             FontSize="13"
                             HeightRequest="34"
                             Text="Red"
                             TextColor="White"/>
              </HorizontalStackLayout>

              <!-- Background -->
              <HorizontalStackLayout Grid.Row="12"
                                     Grid.Column="1"
                                     Spacing="4"
                                     VerticalOptions="Center">
                     <Label Text="Background:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <Button AutomationId="BackgroundLightBlueButton"
                             BackgroundColor="LightBlue"
                             Clicked="OnBackgroundColorButtonClicked"
                             FontSize="13"
                             HeightRequest="34"
                             Text="LBlue"
                             TextColor="Black"/>
                     <Button AutomationId="BackgroundLightYellowButton"
                             BackgroundColor="LightYellow"
                             Clicked="OnBackgroundColorButtonClicked"
                             FontSize="13"
                             HeightRequest="34"
                             Text="LYellow"
                             TextColor="Black"/>
              </HorizontalStackLayout>

              <!-- Return Type -->
              <HorizontalStackLayout Grid.Row="13"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="34"
                                     Spacing="4"
                                     VerticalOptions="Center">
                     <Label Text="ReturnType:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton GroupName="ReturnType"
                                  AutomationId="ReturnTypeSearchButton"
                                  FontSize="13"
                                  CheckedChanged="OnReturnTypeRadioButtonCheckedChanged"
                                  Content="Search"/>
                     <RadioButton GroupName="ReturnType"
                                  AutomationId="ReturnTypeDoneButton"
                                  FontSize="13"
                                  CheckedChanged="OnReturnTypeRadioButtonCheckedChanged"
                                  Content="Done"/>
              </HorizontalStackLayout>

                <!-- Font Auto Scaling -->
              <HorizontalStackLayout Grid.Row="14"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="34"
                                     Spacing="4"
                                     VerticalOptions="Center">
                     <Label Text="AutoScaling:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton GroupName="FontAutoScaling"
                                  Content="True"
                                  FontSize="13"
                                  IsChecked="True"
                                  CheckedChanged="OnFontAutoScalingRadioButtonCheckedChanged"
                                  AutomationId="FontAutoScalingTrueRadioButton"/>
                     <RadioButton GroupName="FontAutoScaling"
                                  Content="False"
                                  FontSize="13"
                                  CheckedChanged="OnFontAutoScalingRadioButtonCheckedChanged"
                                  AutomationId="FontAutoScalingFalseRadioButton"/>
              </HorizontalStackLayout>

                <!-- Font Family -->
              <HorizontalStackLayout Grid.Row="15"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="34"
                                     VerticalOptions="Center">
                     <Label Text="FontFamily:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton GroupName="FontFamily"
                                  AutomationId="FontFamilyDokdoButton"
                                  FontSize="13"
                                  CheckedChanged="OnFontFamilyRadioButtonCheckedChanged"
                                  Content="Dokdo"/>
              </HorizontalStackLayout>


              <!-- IsSpellCheckEnabled -->
              <HorizontalStackLayout Grid.Row="16"
                                     Grid.Column="0">
                     <Label Text="SpellCheck:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton HeightRequest="34"
                                  FontSize="13"
                                  GroupName="IsSpellCheckEnabled"
                                  AutomationId="IsSpellCheckEnabledFalseButton"
                                  CheckedChanged="OnIsSpellCheckEnabledRadioButtonCheckedChanged"
                                  Content="False"/>
              </HorizontalStackLayout>

              <!-- IsReadOnly -->
              <HorizontalStackLayout Grid.Row="16"
                                     Grid.Column="1">
                     <Label Text="IsReadOnly:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton FontSize="13"
                                  GroupName="IsReadOnly"
                                  AutomationId="IsReadOnlyTrueButton"
                                  CheckedChanged="OnIsReadOnlyRadioButtonCheckedChanged"
                                  Content="True"/>
              </HorizontalStackLayout>

            
              <!-- Keyboard (full width, single line) -->
              <HorizontalStackLayout Grid.Row="18"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="34"
                                     VerticalOptions="Center">
                     <Label Text="Keyboard:"
                            FontSize="12"
                            VerticalOptions="Center"/>
                     <RadioButton GroupName="Keyboard"
                                  AutomationId="KeyboardChatButton"
                                  FontSize="13"
                                  CheckedChanged="OnKeyboardRadioButtonCheckedChanged"
                                  Content="Chat"/>
                     <RadioButton GroupName="Keyboard"
                                  AutomationId="KeyboardNumericButton"
                                  FontSize="13"
                                  CheckedChanged="OnKeyboardRadioButtonCheckedChanged"
                                  Content="Numeric"/>
                     <RadioButton GroupName="Keyboard"
                                  AutomationId="KeyboardTextButton"
                                  FontSize="13"
                                  CheckedChanged="OnKeyboardRadioButtonCheckedChanged"
                                  Content="Text"/>
                     <RadioButton GroupName="Keyboard"
                                  AutomationId="KeyboardUrlButton"
                                  FontSize="13"
                                  CheckedChanged="OnKeyboardRadioButtonCheckedChanged"
                                  Content="Url"/>
              </HorizontalStackLayout>
       </Grid>
</ContentPage>
