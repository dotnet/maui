<ContentPage x:Class="Maui.Controls.Sample.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample"
             x:DataType="local:MainPage">
    <ScrollView>
        <VerticalStackLayout x:Name="RootLayout"
                             Padding="20"
                             Spacing="12">
            <Label FontAttributes="Bold"
                   FontSize="28"
                   Text="Handler message batching" />
            <Label Text="Ordinary MAUI controls and compiled bindings. The experiment only changes how existing handler updates are committed." />

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto">
                <Button AutomationId="SingleRoundButton"
                        Clicked="OnSingleRoundClicked"
                        Text="1 update round" />
                <Button Grid.Column="1"
                        AutomationId="HundredRoundsButton"
                        Clicked="OnHundredRoundsClicked"
                        Text="100 update rounds" />
                <Button Grid.Row="1"
                        AutomationId="ResetButton"
                        Clicked="OnResetClicked"
                        Text="Reset" />
                <Label Grid.Row="1"
                       Grid.Column="1"
                       AutomationId="ResultLabel"
                       Text="{Binding Result}"
                       VerticalTextAlignment="Center" />
            </Grid>

            <Button AutomationId="LatencyProbeButton"
                    Clicked="OnLatencyProbeClicked"
                    Text="Measure one-update latency" />
            <Label AutomationId="LatencyResultLabel"
                   Text="{Binding LatencyResult}" />

            <Label AutomationId="ModeLabel"
                   FontAttributes="Bold"
                   Text="{Binding Mode}" />
            <Label AutomationId="StartupResultLabel"
                   Text="{Binding StartupResult}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}"
                                 Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:BatchingRowViewModel">
                        <Grid ColumnDefinitions="2*,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="6">
                            <Label Text="{Binding LabelText}"
                                   TextColor="{Binding AccentColor}"
                                   Opacity="{Binding Opacity}" />
                            <Button Grid.Column="1"
                                    Text="{Binding ButtonText}"
                                    TextColor="{Binding AccentColor}"
                                    Opacity="{Binding Opacity}" />
                            <Entry Grid.Row="1"
                                   AutomationId="{Binding EntryAutomationId}"
                                   Text="{Binding EntryText}"
                                   Placeholder="{Binding Placeholder}"
                                   TextColor="{Binding AccentColor}" />
                            <Switch Grid.Row="1"
                                    Grid.Column="1"
                                    AutomationId="{Binding SwitchAutomationId}"
                                    IsToggled="{Binding IsOn}"
                                    ThumbColor="{Binding AccentColor}"
                                    Opacity="{Binding Opacity}" />
                            <Slider Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Value="{Binding SliderValue}"
                                    MinimumTrackColor="{Binding AccentColor}"
                                    MaximumTrackColor="{Binding MutedColor}"
                                    Opacity="{Binding Opacity}" />
                            <ProgressBar Grid.Row="3"
                                         Grid.ColumnSpan="2"
                                         Progress="{Binding Progress}"
                                         ProgressColor="{Binding AccentColor}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
