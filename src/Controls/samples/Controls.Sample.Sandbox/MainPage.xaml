<ContentPage x:Class="Maui.Controls.Sample.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="CollectionView 2 Tests">

    <Grid RowDefinitions="*,Auto,Auto,*"
          Padding="32"
          RowSpacing="16">
        <Label Grid.Row="1"
               Text="CollectionView 2 Windows"
               FontSize="28"
               HorizontalTextAlignment="Center" />

        <VerticalStackLayout Grid.Row="2"
                             Spacing="12"
                             MaximumWidthRequest="420">
            <Button AutomationId="OpenAccessibilityTests"
                    Text="Accessibility tests"
                    Clicked="OnAccessibilityTestsClicked" />
            <Button AutomationId="OpenTabNavigationTests"
                    Text="Tab navigation tests"
                    Clicked="OnTabNavigationTestsClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>