<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Controls.Sample.MainPage"
             Title="Programmatic context menu">
       <ScrollView>
              <Grid x:Name="SampleRoot"
                            Background="Yellow"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            Padding="24"
                            RowSpacing="16">
                     <VerticalStackLayout BackgroundColor="White"
                                   Padding="16"
                                   Spacing="8">
                            <Label Text="Context menu with icons"
                                          FontSize="20"
                                   FontAttributes="Bold"
                                          TextColor="Black"/>
                            <Label Text="Tap Show context menu to test image and font icons. Light/Dark have sample image icons; nested colors have colored X icons. Off and its icon must remain disabled."
                                   TextColor="Black"/>
                            <Label x:Name="SupportLabel"
                                          AutomationId="ContextMenuSupport"
                                   TextColor="Black"/>
                            <Button x:Name="ShowMenuButton"
                                    AutomationId="ShowContextMenuButton"
                                    Text="Show context menu"
                                    Clicked="OnShowContextMenuClicked"/>
                     </VerticalStackLayout>
                     <Label x:Name="label"
                                                   Grid.Row="1"
                                                   AutomationId="ContextMenuTarget"
                                                   SemanticProperties.Description="Color menu target"
                                                   SemanticProperties.Hint="Use Show context menu to open accessible color choices."
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Center"
                                                   BackgroundColor="White"
                                   TextColor="Black"
                                   Padding="16"
                                                   Text="Color menu anchor">
                            <FlyoutBase.ContextFlyout>
                                   <MenuFlyout>
                                          <MenuFlyoutItem Text="Black"
                                                          Clicked="OnColorSelected"
                                                          CommandParameter="Black">
                                                 <MenuFlyoutItem.IconImageSource>
                                                        <FontImageSource Glyph="X" FontFamily="Segoe UI" Color="Black" Size="20"/>
                                                 </MenuFlyoutItem.IconImageSource>
                                          </MenuFlyoutItem>
                                          <MenuFlyoutSeparator/>
                                          <MenuFlyoutSubItem Text="Light" IconImageSource="shopping_cart.png">
                                                 <MenuFlyoutItem Text="Blue"
                                                                 Clicked="OnColorSelected"
                                                                 CommandParameter="LightBlue">
                                                        <MenuFlyoutItem.IconImageSource>
                                                               <FontImageSource Glyph="X" FontFamily="Segoe UI" Color="LightBlue" Size="20"/>
                                                        </MenuFlyoutItem.IconImageSource>
                                                 </MenuFlyoutItem>
                                                 <MenuFlyoutItem Text="Coral"
                                                                 Clicked="OnColorSelected"
                                                                 CommandParameter="LightCoral">
                                                        <MenuFlyoutItem.IconImageSource>
                                                               <FontImageSource Glyph="X" FontFamily="Segoe UI" Color="LightCoral" Size="20"/>
                                                        </MenuFlyoutItem.IconImageSource>
                                                 </MenuFlyoutItem>
                                                 <MenuFlyoutItem Text="Cyan"
                                                                 Clicked="OnColorSelected"
                                                                 CommandParameter="LightCyan">
                                                        <MenuFlyoutItem.IconImageSource>
                                                               <FontImageSource Glyph="X" FontFamily="Segoe UI" Color="LightCyan" Size="20"/>
                                                        </MenuFlyoutItem.IconImageSource>
                                                 </MenuFlyoutItem>
                                          </MenuFlyoutSubItem>
                                          <MenuFlyoutSubItem Text="Dark" IconImageSource="groceries.png">
                                                 <MenuFlyoutItem Text="Blue"
                                                                 Clicked="OnColorSelected"
                                                                 CommandParameter="DarkBlue">
                                                        <MenuFlyoutItem.IconImageSource>
                                                               <FontImageSource Glyph="X" FontFamily="Segoe UI" Color="DarkBlue" Size="20"/>
                                                        </MenuFlyoutItem.IconImageSource>
                                                 </MenuFlyoutItem>
                                                 <MenuFlyoutItem Text="Cyan"
                                                                 Clicked="OnColorSelected"
                                                                 CommandParameter="DarkCyan">
                                                        <MenuFlyoutItem.IconImageSource>
                                                               <FontImageSource Glyph="X" FontFamily="Segoe UI" Color="DarkCyan" Size="20"/>
                                                        </MenuFlyoutItem.IconImageSource>
                                                 </MenuFlyoutItem>
                                                 <MenuFlyoutItem Text="Magenta"
                                                                 Clicked="OnColorSelected"
                                                                 CommandParameter="DarkMagenta">
                                                        <MenuFlyoutItem.IconImageSource>
                                                               <FontImageSource Glyph="X" FontFamily="Segoe UI" Color="DarkMagenta" Size="20"/>
                                                        </MenuFlyoutItem.IconImageSource>
                                                 </MenuFlyoutItem>
                                          </MenuFlyoutSubItem>
                                          <MenuFlyoutItem Text="Off"
                                                        IsEnabled="False"
                                                          Clicked="OnColorSelected"
                                                          CommandParameter="Red">
                                                 <MenuFlyoutItem.IconImageSource>
                                                        <FontImageSource Glyph="X" FontFamily="Segoe UI" Color="Red" Size="20"/>
                                                 </MenuFlyoutItem.IconImageSource>
                                          </MenuFlyoutItem>
                                   </MenuFlyout>
                            </FlyoutBase.ContextFlyout>
                     </Label>
                     <VerticalStackLayout Grid.Row="2"
                                   BackgroundColor="White"
                                   Padding="16"
                                   Spacing="8">
                            <Label x:Name="StatusLabel"
                                          AutomationId="ContextMenuStatus"
                                   Text="Ready"
                                          TextColor="Black"/>
                            <Button Text="Reset color and selection count"
                                          AutomationId="ResetContextMenuButton"
                                    Clicked="OnResetClicked"/>
                     </VerticalStackLayout>
                     <VerticalStackLayout Grid.Row="3" BackgroundColor="White" Padding="16" Spacing="8">
                            <Label Text="Scrollable context menu" FontSize="20" FontAttributes="Bold" TextColor="Black"/>
                            <Label Text="A separate menu with 25 root actions and a 25-action submenu. Scroll to Root item 25, then reopen and enter More items. Scroll to Nested item 25. Back and Close should remain reachable."
                                   TextColor="Black"/>
                            <Button x:Name="ShowLongMenuButton" AutomationId="ShowLongContextMenuButton"
                                    Text="Show scrollable menu" Clicked="OnShowLongMenuClicked"/>
                            <Label x:Name="LongMenuTarget"
                                    AutomationId="LongContextMenuTarget"
                                    SemanticProperties.Description="Scrollable menu target"
                                    SemanticProperties.Hint="Use Show scrollable menu to open the long menu."
                                    Text="Scrollable menu anchor"
                                    BackgroundColor="White" TextColor="Black" Padding="16"/>
                            <Label x:Name="LongMenuStatusLabel" AutomationId="LongContextMenuStatus"
                                   Text="No selection yet." TextColor="Black"/>
                            <Button Text="Reset scrollable menu counters" Clicked="OnResetLongMenuClicked"/>
                     </VerticalStackLayout>
                     <VerticalStackLayout Grid.Row="4"
                                   BackgroundColor="White"
                                   Padding="16"
                                   Spacing="8">
                            <Label Text="Manual validation"
                                          FontSize="20"
                                          FontAttributes="Bold"
                                          TextColor="Black"/>
                            <Label Text="Open Light, then Back, then Dark. Navigation must not increment the action count. Select one color: exactly one callback per opening. Off must never execute."
                                   TextColor="Black"/>
                            <Label Text="Enable VoiceOver in system accessibility settings. Use Show, explore submenus, then dismiss with Close or outside the menu. Observe where accessibility focus returns; keyboard focus is a separate check."
                                   TextColor="Black"/>
                            <Label Text="Increase system text size (including accessibility sizes), reopen the menu, and rotate the device while it is open. Check wrapping, scrolling, anchor position, and access to Back/Close. This page scrolls to keep test controls reachable."
                                   TextColor="Black"/>
                            <Label x:Name="ActionCountsLabel"
                                          Text="Show requests: 0; actions from all triggers: 0; disabled callbacks: 0."
                                          TextColor="Black"/>
                            <Button Text="Capture accessibility and layout snapshot"
                                          Clicked="OnCaptureDiagnosticsClicked"/>
                            <Label x:Name="DiagnosticsLabel"
                                          Text="No snapshot captured."
                                          TextColor="Black"/>
                            <Picker x:Name="CleanupScenarioPicker"
                                          Title="Delayed menu test"
                                    SelectedIndex="0">
                                   <Picker.Items>
                                          <x:String>Remove attached flyout</x:String>
                                          <x:String>Unload target</x:String>
                                          <x:String>Disconnect handler</x:String>
                                          <x:String>Capture snapshot only (keep menu open)</x:String>
                                   </Picker.Items>
                            </Picker>
                            <Button x:Name="DelayedTestButton"
                                          Text="Open menu; perform selected test after 5 seconds"
                                    Clicked="OnDelayedTestClicked"/>
                            <Button Text="Restore target and attached menu"
                                          Clicked="OnRestoreTargetClicked"/>
                            <Label x:Name="CleanupResultLabel"
                                          Text="No cleanup test run. Dismissal, focus, and accessibility require visual/manual verification."
                                   TextColor="Black"/>
                     </VerticalStackLayout>
              </Grid>
       </ScrollView>
</ContentPage>