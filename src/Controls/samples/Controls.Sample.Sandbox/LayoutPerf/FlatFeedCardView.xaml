<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Maui.Controls.Sample.FlatFeedCardView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample"
             x:DataType="local:FeedItem">

    <!--
        Flattened control variant of HeavyFeedCardView: same text payload, but
          * no Border / StrokeShape wrappers,
          * no nested VerticalStackLayout / HorizontalStackLayout,
          * no nested ScrollView + BindableLayout,
          * one Grid level instead of four.
        Element count per tile drops from ~45 to ~12 and depth from 6 to 3.
    -->
    <Grid Margin="4,6"
          Padding="12"
          BackgroundColor="#1C263A"
          ColumnSpacing="6"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"
               Grid.Column="0"
               FontAttributes="Bold"
               FontAutoScalingEnabled="False"
               FontSize="15"
               Text="{Binding Seller}"
               TextColor="White" />

        <Label Grid.Row="0"
               Grid.Column="1"
               Padding="10,4"
               BackgroundColor="{Binding StatusColor}"
               FontAttributes="Bold"
               FontAutoScalingEnabled="False"
               FontSize="11"
               Text="{Binding Status}"
               TextColor="White"
               VerticalOptions="Center" />

        <Label Grid.Row="1"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               FontAttributes="Bold"
               FontAutoScalingEnabled="False"
               FontSize="{Binding TitleFontSize}"
               LineBreakMode="WordWrap"
               MaxLines="{Binding TitleMaxLines}"
               Text="{Binding Title}"
               TextColor="White" />

        <Label Grid.Row="2"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               FontAutoScalingEnabled="False"
               FontSize="{Binding DescriptionFontSize}"
               LineBreakMode="WordWrap"
               MaxLines="{Binding DescriptionMaxLines}"
               Text="{Binding Description}"
               TextColor="#D7E0EF" />

        <Label Grid.Row="3"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               FontAutoScalingEnabled="False"
               FontSize="12"
               IsVisible="{Binding ShowExtraDetails}"
               LineBreakMode="WordWrap"
               MaxLines="12"
               Text="{Binding ExtraDetails}"
               TextColor="#BFD0EA" />

        <Grid Grid.Row="4"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              ColumnSpacing="6"
              HeightRequest="{Binding PreviewHeight}"
              RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <BoxView Grid.Row="0"
                     Grid.Column="0"
                     Color="#5F6C88" />
            <BoxView Grid.Row="0"
                     Grid.Column="1"
                     Color="#6A5080" />
            <BoxView Grid.Row="1"
                     Grid.Column="0"
                     Color="#3A6060" />
            <BoxView Grid.Row="1"
                     Grid.Column="1"
                     Color="#7A5030" />
        </Grid>

        <Label Grid.Row="5"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               FontAutoScalingEnabled="False"
               FontSize="11"
               LineBreakMode="WordWrap"
               Text="{Binding TagsDisplay}"
               TextColor="#CFE0FA" />

        <Label Grid.Row="6"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               FontAttributes="Bold"
               FontAutoScalingEnabled="False"
               FontSize="13"
               Text="{Binding FooterSummary}"
               TextColor="White" />
    </Grid>
</ContentView>
