<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wordzzle.MainPage"
             Title="Wordzzle"
             BackgroundColor="{AppThemeBinding Light=#F5F4EF, Dark=#17191C}">
    <Grid Padding="14,8"
          RowDefinitions="Auto,Auto,*,Auto,Auto"
          RowSpacing="8">
        <Grid ColumnDefinitions="38,*,Auto,48,48"
              ColumnSpacing="4">
            <Button x:Name="HelpButton"
                    AutomationId="HelpButton"
                    Grid.Column="0"
                    Text="?"
                    FontSize="20"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#30343B, Dark=#F5F4EF}"
                    Clicked="OnHelpClicked"
                    SemanticProperties.Description="How to play" />
            <Label Grid.Column="1"
                   Text="WORDZZLE"
                   FontSize="21"
                   FontAttributes="Bold"
                   CharacterSpacing="1.5"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#30343B, Dark=#F5F4EF}" />
            <Button x:Name="LengthButton"
                    AutomationId="LengthButton"
                    Grid.Column="2"
                    FontSize="12"
                    Padding="8,4"
                    CornerRadius="8"
                    BackgroundColor="{AppThemeBinding Light=#E5E2D9, Dark=#30343B}"
                    TextColor="{AppThemeBinding Light=#30343B, Dark=#F5F4EF}"
                    Clicked="OnLengthClicked"
                    SemanticProperties.Description="Change puzzle length" />
            <Button x:Name="StatsButton"
                    AutomationId="StatsButton"
                    Grid.Column="3"
                    Text="Stats"
                    FontSize="12"
                    Padding="2"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#30343B, Dark=#F5F4EF}"
                    Clicked="OnStatsClicked"
                    SemanticProperties.Description="View game statistics" />
            <Button x:Name="SettingsButton"
                    AutomationId="SettingsButton"
                    Grid.Column="4"
                    Text="Set"
                    FontSize="12"
                    Padding="2"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#30343B, Dark=#F5F4EF}"
                    Clicked="OnSettingsClicked"
                    SemanticProperties.Description="Game settings" />
        </Grid>

        <Label x:Name="DateLabel"
               AutomationId="PuzzleDate"
               Grid.Row="1"
               HorizontalTextAlignment="Center"
               FontSize="13"
               TextColor="{AppThemeBinding Light=#6D7075, Dark=#B6BBC2}" />

        <Grid x:Name="BoardGrid"
              AutomationId="GameBoard"
              Grid.Row="2"
              HorizontalOptions="Center"
              VerticalOptions="Center" />

        <Label x:Name="StatusLabel"
               AutomationId="GameStatus"
               Grid.Row="3"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#30343B, Dark=#F5F4EF}" />

        <Grid x:Name="KeyboardGrid"
              AutomationId="GameKeyboard"
              Grid.Row="4"
              RowSpacing="5" />
    </Grid>
</ContentPage>
