{
  "name": "maui-hybrid-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sdk:build": "npm --prefix ../../../../HybridWebView/JavaScript run build",
    "predev": "npm run sdk:build",
    "dev": "vite",
    "pretype-check": "npm run sdk:build",
    "type-check": "tsc --noEmit",
    "prebuild": "npm run sdk:build",
    "build": "tsc --noEmit && vite build",
    "stage": "npm run build && node stage.mjs",
    "pretest": "npm run sdk:build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@maui/api": "file:../../../../HybridWebView/JavaScript"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
