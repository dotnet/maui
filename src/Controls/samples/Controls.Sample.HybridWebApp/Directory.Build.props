<Project>
  <PropertyGroup>
    <HybridWebAppRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../..'))/</HybridWebAppRepositoryRoot>
    <HybridWebAppInTree Condition="'$(HybridWebAppInTree)' == '' and Exists('$(HybridWebAppRepositoryRoot)src/Maui.InTree.props') and Exists('$(HybridWebAppRepositoryRoot)src/Core/src/Core.csproj') and Exists('$(HybridWebAppRepositoryRoot)Directory.Build.props')">true</HybridWebAppInTree>
    <HybridWebAppInTree Condition="'$(HybridWebAppInTree)' == ''">false</HybridWebAppInTree>
  </PropertyGroup>
  <Import Project="$(HybridWebAppRepositoryRoot)Directory.Build.props" Condition="'$(HybridWebAppInTree)' == 'true' and '$(MauiTestProject)' == 'true'" />
  <Import Project="../Directory.Build.props" Condition="'$(HybridWebAppInTree)' == 'true' and '$(MauiTestProject)' != 'true'" />
  <PropertyGroup Condition="'$(HybridWebAppInTree)' != 'true'">
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">$(MSBuildThisFileDirectory)artifacts/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">$(MSBuildThisFileDirectory)artifacts/bin/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
</Project>
