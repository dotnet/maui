<views:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Maui.Controls.Sample.Pages.TwoPaneViewPage"
    xmlns:views="clr-namespace:Maui.Controls.Sample.Pages.Base"
    xmlns:foldable="clr-namespace:Microsoft.Maui.Controls.Foldable;assembly=Microsoft.Maui.Controls.Foldable"
    Title="TwoPaneView"
    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#111827}">
    <!-- For foldable devices including Surface Duo and iPhone Duo -->
    <!-- Requires Microsoft.Maui.Controls.Foldable NuGet -->
    <views:BasePage.Content>
        <foldable:TwoPaneView x:Name="twoPaneView"
                              MinTallModeHeight="{Binding Source={x:Reference MinTallModeHeight}, Path=Value}"
                              MinWideModeWidth="{Binding Source={x:Reference MinWideModeWidth}, Path=Value}"
                              TallModeConfiguration="{Binding Source={x:Reference TallModeConfiguration}, Path=SelectedItem}"
                              WideModeConfiguration="{Binding Source={x:Reference WideModeConfiguration}, Path=SelectedItem}"
                              PanePriority="{Binding Source={x:Reference PanePriority}, Path=SelectedItem, Mode=TwoWay}"
            >
            <foldable:TwoPaneView.Pane1>
                <ScrollView BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#172554}">
                    <VerticalStackLayout Padding="24" Spacing="12">
                        <Label Text="Pane 1"
                               FontSize="24"
                               FontAttributes="Bold" />
                        <Label Text="Foldable state"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label x:Name="modeLabel" Text="Mode: SinglePane" />
                        <Label x:Name="hingeBoundsLabel" Text="Division region: inactive" />
                        <Label x:Name="spanningBoundsLabel" Text="Spanning panes: 0" />
                        <Label x:Name="hingeAngleLabel" Text="Hinge angle: 0°" />

                        <BoxView HeightRequest="1"
                                 Margin="0,8"
                                 Color="{AppThemeBinding Light=#93C5FD, Dark=#1E40AF}" />

                        <Label Text="Responsive thresholds" FontAttributes="Bold" />
                        <Label Text="Minimum tall-mode height" />
                        <Slider x:Name="MinTallModeHeight" Maximum="2000" />
                        <Label Text="Minimum wide-mode width" />
                        <Slider x:Name="MinWideModeWidth" Maximum="2000" />

                        <Label Text="Pane sizing" FontAttributes="Bold" />
                        <Label Text="Pane 1 length" />
                        <Slider x:Name="Pane1Length" Maximum="1" Value="0.5" />
                        <Label Text="Pane 2 length" />
                        <Slider x:Name="Pane2Length" Maximum="1" Value="0.5" />

                        <Picker x:Name="PanePriority" Title="Pane priority" SelectedIndex="0" />
                        <Picker x:Name="TallModeConfiguration" Title="Tall-mode configuration" SelectedIndex="1" />
                        <Picker x:Name="WideModeConfiguration" Title="Wide-mode configuration" SelectedIndex="1" />

                        <Button Text="Reset settings" Clicked="OnReset" />
                    </VerticalStackLayout>
                </ScrollView>
            </foldable:TwoPaneView.Pane1>
            <foldable:TwoPaneView.Pane2>
                <Grid Padding="24"
                      BackgroundColor="{AppThemeBinding Light=#DCFCE7, Dark=#052E16}">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12">
                        <Label Text="Pane 2"
                               HorizontalTextAlignment="Center"
                               FontSize="24"
                               FontAttributes="Bold" />
                        <Label Text="This pane automatically moves across the active division region."
                               HorizontalTextAlignment="Center" />
                        <Button Text="Reset settings" Clicked="OnReset" />
                    </VerticalStackLayout>
                </Grid>
            </foldable:TwoPaneView.Pane2>
        </foldable:TwoPaneView>
    </views:BasePage.Content>
</views:BasePage>