<Project>
  <Import Project="$(MauiSrcDirectory)Maui.InTree.targets" Condition=" '$(UseMaui)' != 'true' " />
  <Import Project="$(MauiRootDirectory)Directory.Build.targets" />
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Maui.Controls.Sample.Sandbox' and '$(_MauiReplicationAndroidManifest)' != '' and $(TargetFramework.Contains('-android'))">
    <AndroidManifest>$(_MauiReplicationAndroidManifest)</AndroidManifest>
  </PropertyGroup>
</Project>
