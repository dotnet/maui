<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="clr-namespace:Microsoft.Maui;assembly=Microsoft.Maui"
    xmlns:platform="using:Microsoft.Maui.Controls.Platform">
    <platform:NullToUnsetValueConverter x:Key="NullToUnsetValueConverter" />
    <DataTemplate x:Key="TabBarNavigationViewMenuItem">
        <NavigationViewItem 
            x:Name="navViewItem"
            Content="{Binding Content}"
            Background="{Binding Background}" 
            IsEnabled="{Binding IsEnabled}"
            IsSelected="{Binding IsSelected, Mode=TwoWay}"
            MenuItemsSource="{Binding MenuItemsSource}"
            Icon="{Binding Icon}">
            <NavigationViewItem.InfoBadge>
                <InfoBadge
                    Value="{Binding BadgeValue}"
                    Background="{Binding BadgeBackground, Converter={StaticResource NullToUnsetValueConverter}}"
                    Foreground="{Binding BadgeForeground, Converter={StaticResource NullToUnsetValueConverter}}"
                    Visibility="{Binding BadgeVisibility}" />
            </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
    </DataTemplate>


</ResourceDictionary>
