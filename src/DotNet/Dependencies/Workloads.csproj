<Project Sdk="Microsoft.Build.NoTargets">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- .NET 12 runtime manifests are published with the SDK-band version. -->
    <_RuntimeManifestVersion>$(MicrosoftNETSdkPackageVersion)</_RuntimeManifestVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="Microsoft.NET.Workload.Mono.ToolChain.Current.Manifest-$(DotNetVersionBand)"   Version="[$(_RuntimeManifestVersion)]" />
    <PackageDownload Include="Microsoft.NET.Workload.Mono.ToolChain.net11.Manifest-$(DotNetVersionBand)"   Version="[$(_RuntimeManifestVersion)]" />
    <PackageDownload Include="Microsoft.NET.Workload.Emscripten.Current.Manifest-$(DotNetVersionBand)" Version="[$(_RuntimeManifestVersion)]" />
    <PackageDownload Include="Microsoft.NET.Workload.Emscripten.net11.Manifest-$(DotNetVersionBand)" Version="[$(_RuntimeManifestVersion)]" />
    <PackageDownload Include="Microsoft.NET.Sdk.Android.Manifest-$(DotNetAndroidManifestVersionBand)"    Version="[$(MicrosoftAndroidSdkWindowsPackageVersion)]" />
    <PackageDownload Include="Microsoft.NET.Sdk.MacCatalyst.Manifest-$(DotNetMaciOSManifestVersionBand)" Version="[$(MicrosoftMacCatalystSdkPackageVersion)]" />
    <PackageDownload Include="Microsoft.NET.Sdk.iOS.Manifest-$(DotNetMaciOSManifestVersionBand)"         Version="[$(MicrosoftiOSSdkPackageVersion)]" />
    <PackageDownload Include="Microsoft.NET.Sdk.tvOS.Manifest-$(DotNetMaciOSManifestVersionBand)"        Version="[$(MicrosofttvOSSdkPackageVersion)]" />
    <PackageDownload Include="Microsoft.NET.Sdk.macOS.Manifest-$(DotNetMaciOSManifestVersionBand)"       Version="[$(MicrosoftmacOSSdkPackageVersion)]" />
  </ItemGroup>
</Project>