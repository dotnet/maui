<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Mirrors Microsoft.Maui.Core's own TargetFrameworks exactly. The failure this assembly guards
      against is target-framework specific:

        * On a platform TFM the aliased handler interfaces pin PlatformView to one of .NET MAUI's own
          native types, so an external native type produces CS0738.
        * On the platform-neutral and netstandard TFMs the alias is a non-nullable System.Object,
          producing CS9333 (and CS8766, since ViewHandler.PlatformView is object?).

      Compiling the same external-backend sources against every one of them is the only way to prove
      the platform-neutral contracts actually close the gap on all of them. Because both this list and
      Core's expand the same $(MauiPlatforms), the platform set - including whether Tizen is present -
      can never drift between the two. ExternalBackendTargetFrameworkTests asserts that.
    -->
    <TargetFrameworks>netstandard2.1;netstandard2.0;$(_MauiDotNetTfm);$(MauiPlatforms)</TargetFrameworks>
    <AssemblyName>Microsoft.Maui.Core.ExternalBackend.TestAssembly</AssemblyName>
    <RootNamespace>Microsoft.Maui.ExternalBackend</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!--
      This assembly deliberately stands in for a third-party platform backend that lives outside of
      dotnet/maui. It is NOT listed in Core's InternalsVisibleTo, so everything it compiles against is
      provably part of the public .NET MAUI API surface.

      Warnings are errors here on purpose: an external backend must be able to implement the handler
      contracts without nullability mismatches such as CS8766.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <Import Project="$(MauiSrcDirectory)MultiTargeting.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

</Project>
