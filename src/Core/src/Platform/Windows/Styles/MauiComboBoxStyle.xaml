<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:uwp="using:Microsoft.Maui.Platform">

    <uwp:PickerHeaderConverter x:Key="PickerHeaderConverter" />

    <DataTemplate x:Key="ComboBoxHeader">
        <TextBlock
            x:Name="MauiPickerHeader"
            Text="{Binding Converter={StaticResource PickerHeaderConverter}, ConverterParameter=Title}"
            CharacterSpacing="{Binding Converter={StaticResource PickerHeaderConverter}, ConverterParameter=CharacterSpacing}"
            Foreground="{Binding Converter={StaticResource PickerHeaderConverter}, ConverterParameter=TitleColor}" />
    </DataTemplate>

</ResourceDictionary> 