<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>DotNet.Release.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NuGet.Versioning is a pure version parser with no I/O, so it does not violate the
      "Core performs no I/O" rule (docs/design.md section 8). It exists to replace the
      substring hack the current pipeline uses to derive a normalized version.

      Deliberately absent: NuGet.Packaging, NuGet.Protocol, Microsoft.DotNet.*, Azure.*.
      ArchitectureTests asserts that absence.
    -->
    <PackageReference Include="NuGet.Versioning" Version="$(NuGetVersioningPackageVersion)" />
  </ItemGroup>

</Project>
