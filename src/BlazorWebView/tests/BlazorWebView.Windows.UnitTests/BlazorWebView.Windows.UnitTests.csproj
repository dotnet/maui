<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TargetFramework>$(_MauiDotNetTfm)-windows</TargetFramework>
    <RootNamespace>Microsoft.AspNetCore.Components.WebView.Windows.UnitTests</RootNamespace>
    <AssemblyName>Microsoft.AspNetCore.Components.WebView.Windows.UnitTests</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="$(XunitPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WindowsForms\Microsoft.AspNetCore.Components.WebView.WindowsForms.csproj" />
    <ProjectReference Include="..\..\src\Wpf\Microsoft.AspNetCore.Components.WebView.Wpf.csproj" />
  </ItemGroup>

</Project>
