<Border x:Class="MauiApp._1.Pages.Controls.TagView"
        StrokeShape="RoundRectangle 16" 
        HeightRequest="32" 
        StrokeThickness="0" 
        Background="{Binding DisplayColor}"
        x:DataType="Tag">
        <Border.Padding>
            <OnPlatform x:TypeArguments="Thickness" Default="12,0,12,8">
                <On Platform="Android" Value="12,0,12,0" />
            </OnPlatform>
        </Border.Padding>
        
        <Label Text="{Binding Title}" x:Name="TitleLabel"
            TextColor="{AppThemeBinding Light={StaticResource LightBackground},Dark={StaticResource DarkBackground}}" 
            FontSize="14" 
            VerticalOptions="Center"
            VerticalTextAlignment="Center"/>
</Border>