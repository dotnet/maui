<ContentPage xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             x:DataType="TaskDetailPageModel"
             x:Class="MauiApp._1.Pages.TaskDetailPage"
             AutomationId="TaskDetailPage"
             Title="Task">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            AutomationId="DeleteTask"
            Text="Delete"
            Command="{Binding DeleteCommand}"
            Order="Primary"
            Priority="0"
            IconImageSource="{StaticResource IconDelete}"
            SemanticProperties.Description="Delete Task" />
    </ContentPage.ToolbarItems>        

    <Grid SafeAreaEdges="All">
        <ScrollView SafeAreaEdges="None">
            <VerticalStackLayout SafeAreaEdges="None" Spacing="{StaticResource LayoutSpacing}" Padding="{StaticResource LayoutPadding}">
                <sf:SfTextInputLayout Hint="Task">
                    <Entry
                        AutomationId="TaskTitle"
                        Text="{Binding Title}"
                        SemanticProperties.Description="Task" />
                </sf:SfTextInputLayout>

                <sf:SfTextInputLayout Hint="Completed">
                    <CheckBox
                        AutomationId="TaskCompleted"
                        HorizontalOptions="End"
                        IsChecked="{Binding IsCompleted}"
                        SemanticProperties.Description="Completed"
                        SemanticProperties.Hint="Indicates if this task is completed" />
                </sf:SfTextInputLayout>

                <sf:SfTextInputLayout
                    IsVisible="{Binding IsExistingProject}"
                    Hint="Project">
                    <Picker 
                        AutomationId="TaskProject"
                        ItemsSource="{Binding Projects}"
                        ItemDisplayBinding="{Binding Name, x:DataType=Project}"
                        SelectedItem="{Binding Project}"
                        SelectedIndex="{Binding SelectedProjectIndex}"
                        IsOpen="{Binding IsProjectPickerExpanded, Mode=TwoWay}"
                        SemanticProperties.Hint="ComboBox to select a project. Activate to browse and select a project. State Collapsed"/>
                </sf:SfTextInputLayout>

                <Button 
                    AutomationId="SaveTask"
                    Text="Save"
                    Command="{Binding SaveCommand}">
                    <Button.MinimumHeightRequest>
                        <OnIdiom x:TypeArguments="x:Double" Default="44" Desktop="60" />
                    </Button.MinimumHeightRequest>
                </Button>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
