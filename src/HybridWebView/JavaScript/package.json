{
  "name": "@maui/api",
  "version": "0.1.0-preview.1",
  "description": "Experimental .NET MAUI JavaScript SDK for an explicitly registered native command host.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./app/info": {
      "types": "./dist/app/info.d.ts",
      "import": "./dist/app/info.js"
    },
    "./essentials/clipboard": {
      "types": "./dist/essentials/clipboard.d.ts",
      "import": "./dist/essentials/clipboard.js"
    },
    "./essentials/preferences": {
      "types": "./dist/essentials/preferences.d.ts",
      "import": "./dist/essentials/preferences.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/core.js",
    "dist/core.d.ts",
    "dist/app/info.js",
    "dist/app/info.d.ts",
    "dist/essentials/clipboard.js",
    "dist/essentials/clipboard.d.ts",
    "dist/essentials/preferences.js",
    "dist/essentials/preferences.d.ts",
    "README.md",
    "docs/API.md",
    "docs/PROTOCOL.md",
    "docs/RELEASING.md",
    "LICENSE.txt"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotnet/maui.git",
    "directory": "src/HybridWebView/JavaScript"
  },
  "bugs": {
    "url": "https://github.com/dotnet/maui/issues"
  },
  "homepage": "https://github.com/dotnet/maui/tree/net11.0/src/HybridWebView/JavaScript",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack-check": "node scripts/pack-check.mjs",
    "prepack": "npm test"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
