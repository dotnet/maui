<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <MicrosoftExtensionsDependencyInjectionVersion Condition="'$(MicrosoftExtensionsDependencyInjectionVersion)' == ''">11.0.0-rtm.26480.113</MicrosoftExtensionsDependencyInjectionVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls.HybridWebApps" Version="$(HybridAppPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDependencyInjectionVersion)" />
    <ProjectReference Include="../ExternalProvider/ExternalProvider.csproj" AdditionalProperties="HybridAppPackageConsumer=true;HybridAppPackageVersion=$(HybridAppPackageVersion)" />
  </ItemGroup>
  <Target Name="ValidateHybridPackageVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(HybridAppPackageVersion)' == ''" Text="Specify -p:HybridAppPackageVersion=YOUR_PACKED_VERSION and its actual dependency feed. This source-free fixture assumes no published preview version." />
  </Target>
</Project>
