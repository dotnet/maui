<Project>
  <ItemGroup Condition="'$(MSBuildProjectFullPath)' == '$(MauiReplicationAppContainerProject)'">
    <AppxManifest Remove="@(AppxManifest)" />
    <AppxManifest Include="$(MauiReplicationAppContainerManifest)">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <Target
      Name="_ValidateMauiReplicationAppContainerManifestInput"
      BeforeTargets="MauiGeneratePackageAppxManifest"
      Condition="'$(MSBuildProjectFullPath)' == '$(MauiReplicationAppContainerProject)'">
    <Error
        Condition="'$(MauiReplicationAppContainerManifest)' == '' or !Exists('$(MauiReplicationAppContainerManifest)')"
        Text="The trusted replication AppContainer manifest is unavailable." />
    <Error
        Condition="'@(AppxManifest)' != '$(MauiReplicationAppContainerManifest)'"
        Text="The top-level replication AppxManifest input was overridden." />
  </Target>

  <Target
      Name="_ValidateMauiReplicationGeneratedAppContainerManifest"
      BeforeTargets="_ValidatePresenceOfAppxManifestItems"
      DependsOnTargets="MauiGeneratePackageAppxManifest"
      Condition="'$(MSBuildProjectFullPath)' == '$(MauiReplicationAppContainerProject)'">
    <Error
        Condition="'@(AppxManifest->Count())' != '1'"
        Text="The generated replication AppxManifest item is missing or ambiguous." />
    <XmlPeek
        XmlInputPath="@(AppxManifest)"
        Query="/*[local-name()='Package']/*[local-name()='Applications']/*[local-name()='Application']/@*[local-name()='TrustLevel' and namespace-uri()='http://schemas.microsoft.com/appx/manifest/uap/windows10/10']">
      <Output TaskParameter="Result" PropertyName="_MauiReplicationTrustLevel" />
    </XmlPeek>
    <XmlPeek
        XmlInputPath="@(AppxManifest)"
        Query="/*[local-name()='Package']/*[local-name()='Applications']/*[local-name()='Application']/@*[local-name()='RuntimeBehavior' and namespace-uri()='http://schemas.microsoft.com/appx/manifest/uap/windows10/10']">
      <Output TaskParameter="Result" PropertyName="_MauiReplicationRuntimeBehavior" />
    </XmlPeek>
    <XmlPeek
        XmlInputPath="@(AppxManifest)"
        Query="/*[local-name()='Package']/*[local-name()='Applications']/*[local-name()='Application']/@EntryPoint">
      <Output TaskParameter="Result" PropertyName="_MauiReplicationEntryPoint" />
    </XmlPeek>
    <PropertyGroup>
      <_MauiReplicationTrustLevelComparison>$([System.String]::CompareOrdinal('$(_MauiReplicationTrustLevel)', 'appContainer'))</_MauiReplicationTrustLevelComparison>
      <_MauiReplicationRuntimeBehaviorComparison>$([System.String]::CompareOrdinal('$(_MauiReplicationRuntimeBehavior)', 'packagedClassicApp'))</_MauiReplicationRuntimeBehaviorComparison>
      <_MauiReplicationEntryPointComparison>$([System.String]::CompareOrdinal('$(_MauiReplicationEntryPoint)', 'Windows.PartialTrustApplication'))</_MauiReplicationEntryPointComparison>
    </PropertyGroup>
    <Error
        Condition="'$(_MauiReplicationTrustLevelComparison)' != '0' or '$(_MauiReplicationRuntimeBehaviorComparison)' != '0' or '$(_MauiReplicationEntryPointComparison)' != '0'"
        Text="The generated replication manifest does not preserve the partial-trust AppContainer application identity." />
  </Target>
</Project>
