        {"name": "two-fresh", "assert": [{"selector": {"content-desc": "Two", "class": "android.widget.FrameLayout"}, "attributes": {"selected": "true"}}, {"selector": {"text": "Click me", "class": "android.widget.Button"}}], "tap": {"text": "Click me", "class": "android.widget.Button"}},
        {"name": "two-once", "assert": [{"selector": {"text": "Clicked 1 time", "class": "android.widget.Button"}}], "tap": {"content-desc": "Three", "class": "android.widget.FrameLayout"}},
        {"name": "three-fresh", "assert": [{"selector": {"content-desc": "Three", "class": "android.widget.FrameLayout"}, "attributes": {"selected": "true"}}, {"selector": {"text": "Click me", "class": "android.widget.Button"}}], "tap": {"text": "Click me", "class": "android.widget.Button"}},
        {"name": "three-once", "assert": [{"selector": {"text": "Clicked 1 time", "class": "android.widget.Button"}}], "tap": {"content-desc": "Four", "class": "android.widget.FrameLayout"}},
        {"name": "four-fresh", "assert": [{"selector": {"content-desc": "Four", "class": "android.widget.FrameLayout"}, "attributes": {"selected": "true"}}, {"selector": {"text": "Click me", "class": "android.widget.Button"}}], "tap": {"text": "Click me", "class": "android.widget.Button"}},
        {"name": "four-once", "assert": [{"selector": {"text": "Clicked 1 time", "class": "android.widget.Button"}}], "tap": {"content-desc": "One", "class": "android.widget.FrameLayout"}},
        {"name": "one-preserved", "assert": [{"selector": {"content-desc": "One", "class": "android.widget.FrameLayout"}, "attributes": {"selected": "true"}}, {"selector": {"text": "Clicked 2 times", "class": "android.widget.Button"}}], "tap": {"content-desc": "Two", "class": "android.widget.FrameLayout"}},
        {"name": "two-preserved", "assert": [{"selector": {"content-desc": "Two", "class": "android.widget.FrameLayout"}, "attributes": {"selected": "true"}}, {"selector": {"text": "Clicked 1 time", "class": "android.widget.Button"}}]}
