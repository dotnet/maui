        {"name": "employee-detail", "assert": [{"selector": {"text": "Nat Friedman", "class": "android.widget.TextView"}, "count": 2}, {"selector": {"text": "Added to favorites", "class": "android.widget.TextView"}}, {"selector": {"class": "android.widget.Switch"}, "attributes": {"checked": "true"}}], "tap": {"class": "android.widget.Switch"}},
