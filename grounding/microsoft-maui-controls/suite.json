        {"name": "favorites-after-restart", "assert": [{"selector": {"text": "Employee Directory", "class": "android.widget.TextView"}}, {"selector": {"text": "Nat Friedman", "class": "android.widget.TextView"}, "count": 0}, {"selector": {"text": "Miguel de Icaza", "class": "android.widget.TextView"}}], "tap": {"text": "Miguel de Icaza", "class": "android.widget.TextView"}},
        {"name": "favorite-detail-after-restart", "assert": [{"selector": {"text": "Added to favorites", "class": "android.widget.TextView"}}, {"selector": {"class": "android.widget.Switch"}, "attributes": {"checked": "true"}}], "back": true},
