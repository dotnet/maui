    {
      "id": "binding",
      "applicationId": "com.companyname.databindingdemos",
      "complexity": "simple-workflow-in-a-gallery",
      "repo": "dotnet/maui-samples",
      "commit": "e78b47511ac706bb179abc4a09f182355ae75178",
      "archiveSha256": "0a81146cee4bb2161e984b2e49e43753bfa7016476d25bb47fa188f00b968d6f",
      "license": "LICENSE",
      "directory": "10.0/Fundamentals/DataBindingDemos/DataBindingDemos",
      "project": "DataBindingDemos.csproj",
      "prompt": "Upgrade this Android data-binding sample from Controls 10.0.110 / SDK 10.0.301 to Controls 11.0.0-rc.1.26451.6 / SDK 11.0.100-rc.1.26425.128. Preserve the existing sample pages, slider-driven bindings and two-way editing behavior. Keep the application's package-management style, SDK roll-forward disabled and standalone APK installation. Restore/build Debug and Release without disabling analyzers or hiding warnings. Verify the existing behavior on Android; report unavailable prerequisites rather than changing global tools. Only app/ is editable.",
      "runtime": [
        {"name": "open-color", "scrollTo": {"text": "Better Color Selector", "class": "android.widget.Button"}, "assert": [{"selector": {"text": "Better Color Selector", "class": "android.widget.Button"}}], "tap": {"text": "Better Color Selector", "class": "android.widget.Button"}},
        {"name": "color-initial", "assert": [{"selector": {"text": "Sienna", "class": "android.widget.TextView"}}, {"selector": {"text": "Hue = 0.05", "class": "android.widget.TextView"}}], "drag": {"selector": {"class": "android.widget.SeekBar"}, "count": 3, "index": 0, "fraction": 0.5}},
        {"name": "bound-color-changed", "assert": [{"selector": {"$textPrefix": "Hue = ", "class": "android.widget.TextView"}, "number": {"prefix": "Hue = ", "minimum": 0.45, "maximum": 0.55}}], "back": true},
        {"name": "open-converters", "scrollTo": {"text": "Enable Buttons", "class": "android.widget.Button"}, "assert": [{"selector": {"text": "Enable Buttons", "class": "android.widget.Button"}, "count": 2}], "tap": {"text": "Enable Buttons", "class": "android.widget.Button"}, "tapCount": 2, "tapIndex": 0},
        {"name": "converters-empty", "assert": [{"selector": {"text": "Search", "class": "android.widget.Button"}, "attributes": {"enabled": "false"}}, {"selector": {"text": "Submit", "class": "android.widget.Button"}, "attributes": {"enabled": "false"}}], "tap": {"text": "enter search term", "class": "android.widget.EditText"}, "text": "maui", "back": true},
        {"name": "search-bound", "assert": [{"selector": {"text": "Search", "class": "android.widget.Button"}, "attributes": {"enabled": "true"}}, {"selector": {"text": "Submit", "class": "android.widget.Button"}, "attributes": {"enabled": "false"}}], "tap": {"text": "enter destination", "class": "android.widget.EditText"}, "text": "android", "back": true},
        {"name": "independent-converters", "assert": [{"selector": {"text": "Search", "class": "android.widget.Button"}, "attributes": {"enabled": "true"}}, {"selector": {"text": "Submit", "class": "android.widget.Button"}, "attributes": {"enabled": "true"}}], "back": true},
        {"name": "binding-menu-return", "assert": [{"selector": {"text": "Data Binding demos", "class": "android.widget.TextView"}}]}
      ]
    },
    {
